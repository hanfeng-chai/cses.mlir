+/// Parse an inline operation expression.
+ParseResult OperationParser::parseInlineOperation(UnresolvedOperand &result) {
+  SMLoc loc = getToken().getLoc();
+  consumeToken(Token::l_paren);
+  // Parse the operation (generic or custom format).
+  Token nameTok = getToken();
+  Operation *op = nameTok.is(Token::string) ? parseGenericOperation()
+                                            : parseCustomOperation({});
+  if (!op)
+    return failure();
+  if (parseToken(Token::r_paren, "expected ')' to close inline operation"))
+    return failure();
+  if (op->getNumResults() == 0)
+    return emitError(loc, "inline operation must have at least one result");
+
+  // Parse optional result number #N.
+  unsigned resultNo = 0;
+  if (getToken().is(Token::hash_identifier)) {
+    if (auto num = getToken().getHashIdentifierNumber())
+      resultNo = *num;
+    else
+      return emitError("invalid result number");
+    consumeToken(Token::hash_identifier);
+  }
+  if (resultNo >= op->getNumResults())
+    return emitError("result number out of range");
+
+  // Use empty name with unique number to avoid string lifetime issues.
+  result = {loc, "", nextInlineOperationId++};
+  return addDefinition(result, op->getResult(resultNo));
+}
