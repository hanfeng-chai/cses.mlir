fn main() {
    let maximum = 1_000_000;
    let mobius = array(maximum + 1, 0);
    let composite = array(maximum + 1, 0);
    let primes = array(maximum, 0);
    var prime_count = 0;
    mobius[1] = 1;
    for value in 2..=maximum {
        if composite[value] == 0 {
            primes[prime_count] = value;
            prime_count += 1;
            mobius[value] = -1;
        }
        var index = 0;
        var active = true;
        while index < prime_count && active {
            let prime = primes[index];
            if value * prime > maximum {
                active = false;
            } else {
                composite[value * prime] = 1;
                if value % prime == 0 {
                    mobius[value * prime] = 0;
                    active = false;
                } else {
                    mobius[value * prime] = 0 - mobius[value];
                }
            }
            index += 1;
        }
    }
    let count = read();
    let frequencies = array(maximum + 1, 0);
    var largest = 0;
    for index in 0..count {
        let value = read();
        frequencies[value] += 1;
        if value > largest {
            largest = value;
        }
    }
    var answer = 0;
    for divisor in 1..=largest {
        if mobius[divisor] != 0 {
            var multiples = 0;
            var value = divisor;
            while value <= largest {
                multiples += frequencies[value];
                value += divisor;
            }
            answer += mobius[divisor] * multiples * (multiples - 1) / 2;
        }
    }
    println(answer);
}