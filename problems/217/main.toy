fn main() {
    let s = read_text();
    let n = length(s);
    let max_nodes = 2 * n + 2;
    let len = array(max_nodes, 0);
    let link = array(max_nodes, 0);
    let to = array(26 * max_nodes, 0);
    var size = 1;
    var last = 1;
    for idx in 0..n {
        let c = at(s, idx) - 97;
        size += 1;
        let cur = size;
        len[cur] = len[last] + 1;
        var p = last;
        while p != 0 && to[p * 26 + c] == 0 {
            to[p * 26 + c] = cur;
            p = link[p];
        }
        if p == 0 {
            link[cur] = 1;
        } else {
            let q = to[p * 26 + c];
            if len[q] == len[p] + 1 {
                link[cur] = q;
            } else {
                size += 1;
                let clone = size;
                len[clone] = len[p] + 1;
                link[clone] = link[q];
                for t in 0..26 {
                    to[clone * 26 + t] = to[q * 26 + t];
                }
                while p != 0 && to[p * 26 + c] == q {
                    to[p * 26 + c] = clone;
                    p = link[p];
                }
                link[q] = clone;
                link[cur] = clone;
            }
        }
        last = cur;
    }
    let diff = array(n + 2, 0);
    for v in 2..=size {
        diff[len[link[v]] + 1] += 1;
        diff[len[v] + 1] -= 1;
    }
    var current = 0;
    for l in 1..=n {
        current += diff[l];
        if l != 1 {
            print(" ");
        }
        print(current);
    }
    println();
}
