fn snapshot_board(snapshots: array<i64>, codes: array<i64>, length: i64, step: i64) {
    for i in 0..length {
        snapshots[step * length + i] = codes[i];
    }
}

fn main() {
    let n = read();
    let s = read_text();
    let length = 2 * n;
    var codes = array(length, 0);
    for i in 0..length {
        let ch = at(s, i);
        if ch == 65 {
            codes[i] = 0;
        } else if ch == 66 {
            codes[i] = 1;
        } else {
            codes[i] = 2;
        }
    }
    if n == 1 {
        println(0);
        return;
    }
    let snapshots = array(2000 * length, 0);

    var moves_a = array(2000, 0);
    var moves_b = array(2000, 0);
    var move_count = 0;

    if length < 8 {
        // small board BFS
        let parent_state = array(65536, 0);
        for i in 0..65536 {
            parent_state[i] = -1;
        }
        let queue = array(65536, 0);
        var q_head = 0;
        var q_tail = 0;
        for a_count in 0..=length - 2 {
            // goal 1: ".." + letters
            var window = array(8, 0);
            window[0] = 2;
            window[1] = 2;
            for i in 0..length - 2 {
                if i < a_count {
                    window[2 + i] = 0;
                } else {
                    window[2 + i] = 1;
                }
            }
            var encoding = 0;
            var power = 1;
            for i in 0..length {
                encoding += window[i] * power;
                power *= 4;
            }
            if parent_state[encoding] == -1 {
                parent_state[encoding] = encoding;
                queue[q_tail] = encoding;
                q_tail += 1;
            }
            // goal 2: letters with ".." inserted at position 1
            var window2 = array(8, 0);
            window2[1] = 2;
            window2[2] = 2;
            var pos = 0;
            for i in 0..length - 2 {
                if i < a_count {
                    window2[pos] = 0;
                } else {
                    window2[pos] = 1;
                }
                if pos == 0 {
                    pos = 3;
                } else {
                    pos += 1;
                }
            }
            var encoding2 = 0;
            power = 1;
            for i in 0..length {
                encoding2 += window2[i] * power;
                power *= 4;
            }
            if parent_state[encoding2] == -1 {
                parent_state[encoding2] = encoding2;
                queue[q_tail] = encoding2;
                q_tail += 1;
            }
        }
        while q_head < q_tail {
            let encoding = queue[q_head];
            q_head += 1;
            var state = array(8, 0);
            var tmp = encoding;
            for i in 0..length {
                state[i] = tmp % 4;
                tmp = tmp / 4;
            }
            var empty = 0;
            for i in 0..length {
                if state[i] == 2 {
                    empty = i;
                    break;
                }
            }
            for source in 0..length - 1 {
                if state[source] != 2 && state[source + 1] != 2 {
                    var next = array(8, 0);
                    for i in 0..length {
                        next[i] = state[i];
                    }
                    next[empty] = state[source];
                    next[empty + 1] = state[source + 1];
                    next[source] = 2;
                    next[source + 1] = 2;
                    var next_encoding = 0;
                    var power = 1;
                    for i in 0..length {
                        next_encoding += next[i] * power;
                        power *= 4;
                    }
                    if parent_state[next_encoding] == -1 {
                        parent_state[next_encoding] = encoding;
                        queue[q_tail] = next_encoding;
                        q_tail += 1;
                    }
                }
            }
        }
        // reconstruct from start
        var start_encoding = 0;
        var power = 1;
        for i in 0..length {
            start_encoding += codes[i] * power;
            power *= 4;
        }
        if parent_state[start_encoding] == -1 {
            println(-1);
            return;
        }
        var current = start_encoding;
        while parent_state[current] != current {
            current = parent_state[current];
            // decode current into codes
            var tmp = current;
            for i in 0..length {
                codes[i] = tmp % 4;
                tmp = tmp / 4;
            }
            snapshot_board(snapshots, codes, length, move_count);
            move_count += 1;
        }
        println(move_count);
        for step in 0..move_count {
            for i in 0..length {
                if snapshots[step * length + i] == 0 {
                    put(65);
                } else if snapshots[step * length + i] == 1 {
                    put(66);
                } else {
                    put(46);
                }
            }
            put(10);
        }
        return;
    }

    // length >= 8: greedy with window BFS on 8
    let parent_state = array(65536, 0);
    for i in 0..65536 {
        parent_state[i] = -1;
    }
    let queue = array(65536, 0);
    var q_head = 0;
    var q_tail = 0;
    for a_count in 0..=6 {
        var window = array(8, 0);
        window[0] = 2;
        window[1] = 2;
        for i in 0..6 {
            if i < a_count {
                window[2 + i] = 0;
            } else {
                window[2 + i] = 1;
            }
        }
        var encoding = 0;
        var power = 1;
        for i in 0..8 {
            encoding += window[i] * power;
            power *= 4;
        }
        if parent_state[encoding] == -1 {
            parent_state[encoding] = encoding;
            queue[q_tail] = encoding;
            q_tail += 1;
        }
    }
    while q_head < q_tail {
        let encoding = queue[q_head];
        q_head += 1;
        var state = array(8, 0);
        var tmp = encoding;
        for i in 0..8 {
            state[i] = tmp % 4;
            tmp = tmp / 4;
        }
        var empty = 0;
        for i in 0..8 {
            if state[i] == 2 {
                empty = i;
                break;
            }
        }
        for source in 0..7 {
            if state[source] != 2 && state[source + 1] != 2 {
                var next = array(8, 0);
                for i in 0..8 {
                    next[i] = state[i];
                }
                next[empty] = state[source];
                next[empty + 1] = state[source + 1];
                next[source] = 2;
                next[source + 1] = 2;
                var next_encoding = 0;
                var power = 1;
                for i in 0..8 {
                    next_encoding += next[i] * power;
                    power *= 4;
                }
                if parent_state[next_encoding] == -1 {
                    parent_state[next_encoding] = encoding;
                    queue[q_tail] = next_encoding;
                    q_tail += 1;
                }
            }
        }
    }

    // find the empty pair
    var empty = 0;
    for i in 0..length {
        if codes[i] == 2 {
            empty = i;
            break;
        }
    }
    if empty > 1 {
        moves_a[move_count] = empty;
        moves_b[move_count] = 0;
        let t0 = codes[empty];
        codes[empty] = codes[0];
        codes[0] = t0;
        let t1 = codes[empty + 1];
        codes[empty + 1] = codes[1];
        codes[1] = t1;
        empty = 0;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
    } else if empty == 1 {
        moves_a[move_count] = 1;
        moves_b[move_count] = 3;
        let t0 = codes[1];
        codes[1] = codes[3];
        codes[3] = t0;
        let t1 = codes[2];
        codes[2] = codes[4];
        codes[4] = t1;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
        moves_a[move_count] = 3;
        moves_b[move_count] = 0;
        var t2 = codes[3];
        codes[3] = codes[0];
        codes[0] = t2;
        var t3 = codes[4];
        codes[4] = codes[1];
        codes[1] = t3;
        empty = 0;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
    }

    var cursor = 0;
    var possible = true;
    while cursor + 8 < length && possible {
        if codes[cursor + 2] == 0 && codes[cursor + 3] == 0 {
            // move the AA pair at cursor+2 into the empty pair at cursor
            moves_a[move_count] = cursor;
            moves_b[move_count] = cursor + 2;
            let t0 = codes[cursor];
            codes[cursor] = codes[cursor + 2];
            codes[cursor + 2] = t0;
            let t1 = codes[cursor + 1];
            codes[cursor + 1] = codes[cursor + 3];
            codes[cursor + 3] = t1;
            cursor += 2;
            snapshot_board(snapshots, codes, length, move_count);
            move_count += 1;
            continue;
        }
        var first_b = -1;
        var i = cursor;
        while i < length {
            if codes[i] == 1 {
                first_b = i;
                break;
            }
            i += 1;
        }
        var later_a = -1;
        var j = first_b + 2;
        while j < length {
            if codes[j] == 0 {
                later_a = j;
                break;
            }
            j += 1;
        }
        if later_a == -1 {
            // solve window at cursor
            var window_encoding = 0;
            var power = 1;
            for i in 0..8 {
                window_encoding += codes[cursor + i] * power;
                power *= 4;
            }
            if parent_state[window_encoding] == -1 {
                possible = false;
                break;
            }
            var current = window_encoding;
            while parent_state[current] != current {
                current = parent_state[current];
                var tmp = current;
                for i in 0..8 {
                    codes[cursor + i] = tmp % 4;
                    tmp = tmp / 4;
                }
                snapshot_board(snapshots, codes, length, move_count);
                move_count += 1;
            }
            break;
        }
        var last_cell = false;
        if later_a == length - 1 {
            later_a -= 1;
            last_cell = true;
        }
        // three moves
        moves_a[move_count] = cursor;
        moves_b[move_count] = first_b;
        let t0 = codes[cursor];
        codes[cursor] = codes[first_b];
        codes[first_b] = t0;
        let t1 = codes[cursor + 1];
        codes[cursor + 1] = codes[first_b + 1];
        codes[first_b + 1] = t1;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
        moves_a[move_count] = first_b;
        moves_b[move_count] = later_a;
        var t2 = codes[first_b];
        codes[first_b] = codes[later_a];
        codes[later_a] = t2;
        var t3 = codes[first_b + 1];
        codes[first_b + 1] = codes[later_a + 1];
        codes[later_a + 1] = t3;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
        moves_a[move_count] = later_a;
        moves_b[move_count] = cursor;
        var t4 = codes[later_a];
        codes[later_a] = codes[cursor];
        codes[cursor] = t4;
        var t5 = codes[later_a + 1];
        codes[later_a + 1] = codes[cursor + 1];
        codes[cursor + 1] = t5;
        snapshot_board(snapshots, codes, length, move_count);
        move_count += 1;
        if last_cell {
            var window_encoding = 0;
            var power = 1;
            for i in 0..8 {
                window_encoding += codes[cursor + i] * power;
                power *= 4;
            }
            if parent_state[window_encoding] == -1 {
                possible = false;
                break;
            }
            var current = window_encoding;
            while parent_state[current] != current {
                current = parent_state[current];
                var tmp = current;
                for i in 0..8 {
                    codes[cursor + i] = tmp % 4;
                    tmp = tmp / 4;
                }
                snapshot_board(snapshots, codes, length, move_count);
                move_count += 1;
            }
        }
    }
    if possible {
        var window_encoding = 0;
        var power = 1;
        for i in 0..8 {
            window_encoding += codes[cursor + i] * power;
            power *= 4;
        }
        if parent_state[window_encoding] == -1 {
            possible = false;
        } else {
            var current = window_encoding;
            while parent_state[current] != current {
                current = parent_state[current];
                var tmp = current;
                for i in 0..8 {
                    codes[cursor + i] = tmp % 4;
                    tmp = tmp / 4;
                }
                snapshot_board(snapshots, codes, length, move_count);
                move_count += 1;
            }
        }
    }
    if !possible {
        println(-1);
        return;
    }
    println(move_count);
    for step in 0..move_count {
        for i in 0..length {
            if snapshots[step * length + i] == 0 {
                put(65);
            } else if snapshots[step * length + i] == 1 {
                put(66);
            } else {
                put(46);
            }
        }
        put(10);
    }
}
