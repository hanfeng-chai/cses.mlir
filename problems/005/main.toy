fn main() {
    let n = read();
    if n == 1 {
        println(1);
    } else if n <= 3 {
        println("NO SOLUTION");
    } else {
        for value in 2..=n by 2 {
            print(value, " ");
        }
        for value in 1..=n by 2 {
            print(value, " ");
        }
        println();
    }
}