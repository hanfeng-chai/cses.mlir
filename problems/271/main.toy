fn less_than(first: i64, second: i64) -> bool {
    print("? ");
    print(first);
    print(" ");
    println(second);
    flush();
    let response = read_text();
    return at(response, 0) == 89;
}

fn main() {
    let n = read();
    var idx = array(n, 0);
    var buffer = array(n, 0);
    for i in 0..n {
        idx[i] = i + 1;
    }
    var width = 1;
    while width < n {
        var start = 0;
        while start < n {
            var mid = start + width;
            if mid > n {
                mid = n;
            }
            var finish = start + 2 * width;
            if finish > n {
                finish = n;
            }
            var i = start;
            var j = mid;
            var k = start;
            while i < mid && j < finish {
                if less_than(idx[i], idx[j]) {
                    buffer[k] = idx[i];
                    i += 1;
                } else {
                    buffer[k] = idx[j];
                    j += 1;
                }
                k += 1;
            }
            while i < mid {
                buffer[k] = idx[i];
                i += 1;
                k += 1;
            }
            while j < finish {
                buffer[k] = idx[j];
                j += 1;
                k += 1;
            }
            start = finish;
        }
        for i in 0..n {
            idx[i] = buffer[i];
        }
        width *= 2;
    }
    // convert sorted indices to the permutation: value v sits at sorted rank r,
    // the permutation a[idx[r]-1] = v (position idx[r]-1 holds rank r)
    var a = array(n, 0);
    for r in 0..n {
        a[idx[r] - 1] = r + 1;
    }
    print("! ");
    for i in 0..n {
        if i > 0 {
            print(" ");
        }
        print(a[i]);
    }
    println();
    flush();
}
