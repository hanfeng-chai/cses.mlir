fn main() {
    let text = read_text();
    let n_total = length(text);
    let count = array(128, 0);
    for i in 0..n_total {
        let code = at(text, i);
        count[code] += 1;
    }
    let start = array(128, 0);
    var run = 0;
    for c in 0..128 {
        start[c] = run;
        run += count[c];
    }
    let occ = array(128, 0);
    let lf = array(n_total, 0);
    for i in 0..n_total {
        let code = at(text, i);
        lf[i] = start[code] + occ[code];
        occ[code] += 1;
    }
    var j = 0;
    var found = false;
    var idx = 0;
    while !found {
        if at(text, idx) == 35 {
            j = idx;
            found = true;
        }
        idx += 1;
    }
    let chain = array(n_total, 0);
    var current = j;
    for k in 0..n_total {
        current = lf[current];
        chain[k] = current;
    }
    var k = n_total - 2;
    while k >= 0 {
        put(at(text, chain[k]));
        k -= 1;
    }
    put(10);
}
