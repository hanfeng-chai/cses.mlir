fn main() {
    let s = read_text();
    let n = length(s);
    // next occurrence table: nxt[i*4+c]
    let nxt = array((n + 1) * 4, n);
    for i in n - 1..=0 by -1 {
        for c in 0..4 {
            nxt[i * 4 + c] = nxt[(i + 1) * 4 + c];
        }
        let ch = at(s, i);
        var code = 0;
        if ch == 67 {
            code = 1;
        } else if ch == 71 {
            code = 2;
        } else if ch == 84 {
            code = 3;
        }
        nxt[i * 4 + code] = i;
    }

    var f = array(n + 1, 0);
    var choice = array(n + 1, 0);
    for i in n..=0 by -1 {
        var best = n + 2;
        var best_c = 0;
        for c in 0..4 {
            var value = 1;
            if nxt[i * 4 + c] != n {
                value = 1 + f[nxt[i * 4 + c] + 1];
            }
            if value < best {
                best = value;
                best_c = c;
            }
        }
        f[i] = best;
        choice[i] = best_c;
    }

    var pos = 0;
    while true {
        let c = choice[pos];
        var letter = 65;
        if c == 1 {
            letter = 67;
        } else if c == 2 {
            letter = 71;
        } else if c == 3 {
            letter = 84;
        }
        put(letter);
        if nxt[pos * 4 + c] == n {
            break;
        }
        pos = nxt[pos * 4 + c] + 1;
    }
    put(10);
}
