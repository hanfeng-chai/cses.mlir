fn main() {
    let text = read_text();
    let size = length(text);
    var best = 0;
    var current = 0;
    for index in 0..size {
        if index == 0 {
            current = 1;
        } else if at(text, index) == at(text, index - 1) {
            current += 1;
        } else {
            current = 1;
        }
        if current > best {
            best = current;
        }
    }
    println(best);
}