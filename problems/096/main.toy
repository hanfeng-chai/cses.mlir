fn main() {
    let nodes = read();
    let edges = read();
    let head = array(nodes + 1, -1);
    let to = array(edges, 0);
    let next = array(edges, 0);
    for edge in 0..edges {
        let source = read();
        to[edge] = read();
        next[edge] = head[source];
        head[source] = edge;
    }
    let state = array(nodes + 1, 0);
    let parent = array(nodes + 1, 0);
    let cursor = array(nodes + 1, -1);
    let stack = array(nodes, 0);
    let cycle = array(nodes + 1, 0);
    var cycle_size = 0;
    for start in 1..=nodes {
        if state[start] == 0 && cycle_size == 0 {
            var stack_size = 1;
            stack[0] = start;
            state[start] = 1;
            cursor[start] = head[start];
            while stack_size > 0 && cycle_size == 0 {
                let node = stack[stack_size - 1];
                let edge = cursor[node];
                if edge == -1 {
                    state[node] = 2;
                    stack_size -= 1;
                } else {
                    cursor[node] = next[edge];
                    let neighbor = to[edge];
                    if state[neighbor] == 1 {
                        cycle[0] = neighbor;
                        cycle_size = 1;
                        var current = node;
                        while current != neighbor {
                            cycle[cycle_size] = current;
                            cycle_size += 1;
                            current = parent[current];
                        }
                        cycle[cycle_size] = neighbor;
                        cycle_size += 1;
                    } else if state[neighbor] == 0 {
                        state[neighbor] = 1;
                        parent[neighbor] = node;
                        cursor[neighbor] = head[neighbor];
                        stack[stack_size] = neighbor;
                        stack_size += 1;
                    }
                }
            }
        }
    }
    if cycle_size == 0 {
        println("IMPOSSIBLE");
    } else {
        println(cycle_size);
        while cycle_size > 0 {
            cycle_size -= 1;
            print(cycle[cycle_size], " ");
        }
        println();
    }
}