fn main() {
    let n = read();
    let m = read();
    var grid = array(n * m, 0);
    for r in 0..n {
        let line = read_text();
        for c in 0..m {
            grid[r * m + c] = at(line, c) - 65;
        }
    }
    let cells = n * m;
    let v_count = 2 * cells;
    var head = array(v_count, 0);
    for i in 0..v_count {
        head[i] = -1;
    }
    let max_edges = 16 * cells + 10;
    let to = array(max_edges, 0);
    let next_edge = array(max_edges, 0);
    var edge_count = 0;

    for r in 0..n {
        for c in 0..m {
            let i = r * m + c;
            let orig = grid[i];
            var o0 = 0;
            var o1 = 1;
            if orig == 0 {
                o0 = 1;
                o1 = 2;
            } else if orig == 1 {
                o0 = 0;
                o1 = 2;
            }
            // right neighbor
            if c + 1 < m {
                let j = r * m + c + 1;
                let orig2 = grid[j];
                var p0 = 0;
                var p1 = 1;
                if orig2 == 0 {
                    p0 = 1;
                    p1 = 2;
                } else if orig2 == 1 {
                    p0 = 0;
                    p1 = 2;
                }
                for a in 0..2 {
                    var oa = o0;
                    if a == 1 {
                        oa = o1;
                    }
                    for b in 0..2 {
                        var pb = p0;
                        if b == 1 {
                            pb = p1;
                        }
                        if oa == pb {
                            // forbid literal (2i + (1-a)) and (2j + (1-b))
                            let u = 2 * i + (1 - a);
                            let v = 2 * j + (1 - b);
                            to[edge_count] = v;
                            next_edge[edge_count] = head[u ^ 1];
                            head[u ^ 1] = edge_count;
                            edge_count += 1;
                            to[edge_count] = u;
                            next_edge[edge_count] = head[v ^ 1];
                            head[v ^ 1] = edge_count;
                            edge_count += 1;
                        }
                    }
                }
            }
            // down neighbor
            if r + 1 < n {
                let j = (r + 1) * m + c;
                let orig2 = grid[j];
                var p0 = 0;
                var p1 = 1;
                if orig2 == 0 {
                    p0 = 1;
                    p1 = 2;
                } else if orig2 == 1 {
                    p0 = 0;
                    p1 = 2;
                }
                for a in 0..2 {
                    var oa = o0;
                    if a == 1 {
                        oa = o1;
                    }
                    for b in 0..2 {
                        var pb = p0;
                        if b == 1 {
                            pb = p1;
                        }
                        if oa == pb {
                            let u = 2 * i + (1 - a);
                            let v = 2 * j + (1 - b);
                            to[edge_count] = v;
                            next_edge[edge_count] = head[u ^ 1];
                            head[u ^ 1] = edge_count;
                            edge_count += 1;
                            to[edge_count] = u;
                            next_edge[edge_count] = head[v ^ 1];
                            head[v ^ 1] = edge_count;
                            edge_count += 1;
                        }
                    }
                }
            }
        }
    }

    // iterative Tarjan
    var num = array(v_count, 0);
    var low = array(v_count, 0);
    var comp = array(v_count, 0);
    var on_stack = array(v_count, 0);
    var stk = array(v_count, 0);
    var call_stack = array(v_count, 0);
    var idx_stack = array(v_count, 0);
    for i in 0..v_count {
        num[i] = -1;
        comp[i] = -1;
    }
    var timer = 0;
    var comp_count = 0;
    var sp = 0;
    var cur_edge = array(v_count, 0);

    for start in 0..v_count {
        if num[start] != -1 {
            continue;
        }
        num[start] = timer;
        low[start] = timer;
        timer += 1;
        stk[sp] = start;
        sp += 1;
        on_stack[start] = 1;
        var call_top = 0;
        call_stack[0] = start;
        idx_stack[0] = 0;
        cur_edge[start] = head[start];
        while call_top >= 0 {
            let node = call_stack[call_top];
            let edge = cur_edge[node];
            if edge != -1 {
                cur_edge[node] = next_edge[edge];
                let target = to[edge];
                if num[target] == -1 {
                    num[target] = timer;
                    low[target] = timer;
                    timer += 1;
                    stk[sp] = target;
                    sp += 1;
                    on_stack[target] = 1;
                    call_top += 1;
                    call_stack[call_top] = target;
                    idx_stack[call_top] = 0;
                    cur_edge[target] = head[target];
                } else if on_stack[target] == 1 {
                    if num[target] < low[node] {
                        low[node] = num[target];
                    }
                }
            } else {
                call_top -= 1;
                if call_top >= 0 {
                    let parent = call_stack[call_top];
                    if low[node] < low[parent] {
                        low[parent] = low[node];
                    }
                }
                if low[node] == num[node] {
                    while true {
                        sp -= 1;
                        let x = stk[sp];
                        on_stack[x] = 0;
                        comp[x] = comp_count;
                        if x == node {
                            break;
                        }
                    }
                    comp_count += 1;
                }
            }
        }
    }

    var ok = true;
    for i in 0..cells {
        if comp[2 * i] == comp[2 * i + 1] {
            ok = false;
            break;
        }
    }
    if !ok {
        print("IMPOSSIBLE\n");
        return;
    }
    for r in 0..n {
        for c in 0..m {
            let i = r * m + c;
            let orig = grid[i];
            var o0 = 0;
            var o1 = 1;
            if orig == 0 {
                o0 = 1;
                o1 = 2;
            } else if orig == 1 {
                o0 = 0;
                o1 = 2;
            }
            if comp[2 * i] < comp[2 * i + 1] {
                put(65 + o0);
            } else {
                put(65 + o1);
            }
        }
        put(10);
    }
}
