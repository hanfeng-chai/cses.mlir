fn apply_assign(
    sum: array<i64>, add: array<i64>, assigned: array<i64>, has_assign: array<i64>,
    node: i64, left: i64, right: i64, value: i64
) {
    sum[node] = value * (right - left + 1);
    assigned[node] = value;
    has_assign[node] = 1;
    add[node] = 0;
}

fn apply_add(
    sum: array<i64>, add: array<i64>,
    node: i64, left: i64, right: i64, value: i64
) {
    sum[node] += value * (right - left + 1);
    add[node] += value;
}

fn push(
    sum: array<i64>, add: array<i64>, assigned: array<i64>, has_assign: array<i64>,
    node: i64, left: i64, right: i64
) {
    if left != right {
        let middle = (left + right) / 2;
        if has_assign[node] != 0 {
            apply_assign(sum, add, assigned, has_assign, 2 * node, left, middle, assigned[node]);
            apply_assign(sum, add, assigned, has_assign, 2 * node + 1, middle + 1, right, assigned[node]);
            has_assign[node] = 0;
        }
        if add[node] != 0 {
            apply_add(sum, add, 2 * node, left, middle, add[node]);
            apply_add(sum, add, 2 * node + 1, middle + 1, right, add[node]);
            add[node] = 0;
        }
    }
}

fn update(
    sum: array<i64>, add: array<i64>, assigned: array<i64>, has_assign: array<i64>,
    node: i64, left: i64, right: i64,
    query_left: i64, query_right: i64, value: i64, kind: i64
) {
    if query_right >= left && right >= query_left {
        if query_left <= left && right <= query_right {
            if kind == 1 {
                apply_add(sum, add, node, left, right, value);
            } else {
                apply_assign(sum, add, assigned, has_assign, node, left, right, value);
            }
        } else {
            push(sum, add, assigned, has_assign, node, left, right);
            let middle = (left + right) / 2;
            update(
                sum, add, assigned, has_assign, 2 * node, left, middle,
                query_left, query_right, value, kind
            );
            update(
                sum, add, assigned, has_assign, 2 * node + 1, middle + 1, right,
                query_left, query_right, value, kind
            );
            sum[node] = sum[2 * node] + sum[2 * node + 1];
        }
    }
}

fn query(
    sum: array<i64>, add: array<i64>, assigned: array<i64>, has_assign: array<i64>,
    node: i64, left: i64, right: i64, query_left: i64, query_right: i64
) -> i64 {
    var result = 0;
    if query_right >= left && right >= query_left {
        if query_left <= left && right <= query_right {
            result = sum[node];
        } else {
            push(sum, add, assigned, has_assign, node, left, right);
            let middle = (left + right) / 2;
            result = query(
                sum, add, assigned, has_assign, 2 * node, left, middle,
                query_left, query_right
            ) + query(
                sum, add, assigned, has_assign, 2 * node + 1, middle + 1, right,
                query_left, query_right
            );
        }
    }
    return result;
}

fn main() {
    let size = read();
    let queries = read();
    let tree_size = 4 * size + 4;
    let sum = array(tree_size, 0);
    let add = array(tree_size, 0);
    let assigned = array(tree_size, 0);
    let has_assign = array(tree_size, 0);
    for index in 1..=size {
        let value = read();
        update(sum, add, assigned, has_assign, 1, 1, size, index, index, value, 1);
    }
    for operation in 0..queries {
        let kind = read();
        let left = read();
        let right = read();
        if kind <= 2 {
            update(sum, add, assigned, has_assign, 1, 1, size, left, right, read(), kind);
        } else {
            println(query(sum, add, assigned, has_assign, 1, 1, size, left, right));
        }
    }
}