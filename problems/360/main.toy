fn main() {
    let n = read();
    let a = read();
    let x = read_array(n);
    let offset = n * 500 + 5;
    let size = 2 * offset + 1;
    let dp = array(size, 0);
    dp[offset] = 1;
    for i in 0..n {
        let y = x[i] - a;
        if y >= 0 {
            for s in size - 1..=y by -1 {
                if dp[s - y] != 0 {
                    dp[s] = (dp[s] + dp[s - y]) % 1000000007;
                }
            }
        } else {
            for s in 0..size + y {
                if dp[s - y] != 0 {
                    dp[s] = (dp[s] + dp[s - y]) % 1000000007;
                }
            }
        }
    }
    var ans = (dp[offset] - 1) % 1000000007;
    if ans < 0 {
        ans += 1000000007;
    }
    println(ans);
}
