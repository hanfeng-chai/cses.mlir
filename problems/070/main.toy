fn main() {
    let first_size = read();
    let second_size = read();
    let first = array(first_size, 0);
    let second = array(second_size, 0);
    for index in 0..first_size {
        first[index] = read();
    }
    for index in 0..second_size {
        second[index] = read();
    }
    let width = second_size + 1;
    let common = array((first_size + 1) * width, 0);
    for row in 1..=first_size {
        for column in 1..=second_size {
            let cell = row * width + column;
            if first[row - 1] == second[column - 1] {
                common[cell] = common[(row - 1) * width + column - 1] + 1;
            } else {
                common[cell] = common[(row - 1) * width + column];
                if common[row * width + column - 1] > common[cell] {
                    common[cell] = common[row * width + column - 1];
                }
            }
        }
    }
    let result_size = common[first_size * width + second_size];
    let result = array(result_size, 0);
    var row = first_size;
    var column = second_size;
    var used = 0;
    while row > 0 && column > 0 {
        if first[row - 1] == second[column - 1] {
            result[used] = first[row - 1];
            used += 1;
            row -= 1;
            column -= 1;
        } else if common[(row - 1) * width + column] >= common[row * width + column - 1] {
            row -= 1;
        } else {
            column -= 1;
        }
    }
    println(result_size);
    while used > 0 {
        used -= 1;
        print(result[used], " ");
    }
    println();
}