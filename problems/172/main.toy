fn main() {
    let children = read();
    let apples = read();
    let total = children + apples - 1;
    let modulus = 1_000_000_007;
    let factorial = array(total + 1, 1);
    for value in 1..=total {
        factorial[value] = factorial[value - 1] * value % modulus;
    }
    let answer = factorial[total]
        * pow_mod(factorial[apples], modulus - 2, modulus) % modulus
        * pow_mod(factorial[children - 1], modulus - 2, modulus) % modulus;
    println(answer);
}