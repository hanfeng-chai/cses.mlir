fn sift_slice(values: array<i64>, start: i64, count: i64) {
    var index = start;
    while 2 * index + 1 < count {
        var child = 2 * index + 1;
        if child + 1 < count && values[child + 1] > values[child] {
            child += 1;
        }
        if values[child] <= values[index] {
            return;
        }
        let temporary = values[index];
        values[index] = values[child];
        values[child] = temporary;
        index = child;
    }
}

fn heap_sort_slice(values: array<i64>, count: i64) {
    var begin = count / 2;
    while begin > 0 {
        begin -= 1;
        sift_slice(values, begin, count);
    }
    var end = count;
    while end > 1 {
        end -= 1;
        let temporary = values[0];
        values[0] = values[end];
        values[end] = temporary;
        sift_slice(values, 0, end);
    }
}

fn main() {
    let n = read();
    let m = read();
    let head = array(n + 1, -1);
    let to = array(m, 0);
    let next = array(m, 0);
    let weight = array(m, 0);
    let head_r = array(n + 1, -1);
    let to_r = array(m, 0);
    let next_r = array(m, 0);
    let weight_r = array(m, 0);
    let edge_a = array(m, 0);
    let edge_b = array(m, 0);
    let edge_w = array(m, 0);
    for e in 0..m {
        let a = read();
        let b = read();
        let w = read();
        edge_a[e] = a;
        edge_b[e] = b;
        edge_w[e] = w;
        to[e] = b;
        weight[e] = w;
        next[e] = head[a];
        head[a] = e;
        to_r[e] = a;
        weight_r[e] = w;
        next_r[e] = head_r[b];
        head_r[b] = e;
    }
    let infinity = 9223372036854775807;
    let d1 = array(n + 1, infinity);
    let d2 = array(n + 1, infinity);
    let queue = heap(m + 1);
    d1[1] = 0;
    heap_push(queue, 0, 1);
    while heap_size(queue) > 0 {
        let current_distance = heap_first(queue);
        let node = heap_second(queue);
        heap_pop(queue);
        if current_distance <= d1[node] {
            var e = head[node];
            while e != -1 {
                let v = to[e];
                let candidate = current_distance + weight[e];
                if candidate < d1[v] {
                    d1[v] = candidate;
                    heap_push(queue, candidate, v);
                }
                e = next[e];
            }
        }
    }
    d2[n] = 0;
    heap_push(queue, 0, n);
    while heap_size(queue) > 0 {
        let current_distance = heap_first(queue);
        let node = heap_second(queue);
        heap_pop(queue);
        if current_distance <= d2[node] {
            var e = head_r[node];
            while e != -1 {
                let v = to_r[e];
                let candidate = current_distance + weight_r[e];
                if candidate < d2[v] {
                    d2[v] = candidate;
                    heap_push(queue, candidate, v);
                }
                e = next_r[e];
            }
        }
    }
    let total = d1[n];
    let pred_head = array(n + 1, -1);
    let pred_next = array(m, -1);
    let pred_val = array(m, 0);
    for e in 0..m {
        let a = edge_a[e];
        let b = edge_b[e];
        if d1[a] < infinity && d2[b] < infinity && d1[a] + edge_w[e] + d2[b] == total {
            pred_val[e] = a;
            pred_next[e] = pred_head[b];
            pred_head[b] = e;
        }
    }
    let node_list = array(n, 0);
    let node_dist = array(n, 0);
    var node_count = 0;
    for v in 1..=n {
        if d1[v] < infinity && d2[v] < infinity && d1[v] + d2[v] == total {
            node_list[node_count] = v;
            node_dist[node_count] = d1[v];
            node_count += 1;
        }
    }
    for i in node_count..n {
        node_dist[i] = infinity;
        node_list[i] = infinity;
    }
    sort_pairs(node_dist, node_list);
    var levels = 1;
    while (1 << levels) < n {
        levels += 1;
    }
    levels += 1;
    let stride = n + 1;
    let upd = array(levels * stride, 0);
    let idom = array(n + 1, -1);
    let dom_depth = array(n + 1, 0);
    idom[1] = 1;
    for k in 0..levels {
        upd[k * stride + 1] = 1;
    }
    for i in 0..node_count {
        let v = node_list[i];
        if v == 1 {
            continue;
        }
        var new_idom = -1;
        var e = pred_head[v];
        while e != -1 {
            let p = pred_val[e];
            if idom[p] != -1 {
                if new_idom == -1 {
                    new_idom = p;
                } else {
                    var first = new_idom;
                    var second = p;
                    if dom_depth[first] < dom_depth[second] {
                        let temporary = first;
                        first = second;
                        second = temporary;
                    }
                    var difference = dom_depth[first] - dom_depth[second];
                    var k = 0;
                    while k < levels {
                        if ((difference >> k) & 1) == 1 {
                            first = upd[k * stride + first];
                        }
                        k += 1;
                    }
                    if first != second {
                        var k2 = levels - 1;
                        while k2 >= 0 {
                            if upd[k2 * stride + first] != upd[k2 * stride + second] {
                                first = upd[k2 * stride + first];
                                second = upd[k2 * stride + second];
                            }
                            k2 -= 1;
                        }
                        first = upd[first];
                    }
                    new_idom = first;
                }
            }
            e = pred_next[e];
        }
        if new_idom == -1 {
            continue;
        }
        idom[v] = new_idom;
        dom_depth[v] = dom_depth[new_idom] + 1;
        upd[v] = new_idom;
        for k in 1..levels {
            upd[k * stride + v] = upd[(k - 1) * stride + upd[(k - 1) * stride + v]];
        }
    }
    let critical = array(n, 0);
    var critical_count = 0;
    var x = n;
    var walking = true;
    while walking {
        critical[critical_count] = x;
        critical_count += 1;
        if x == 1 {
            walking = false;
        } else {
            x = idom[x];
        }
    }
    heap_sort_slice(critical, critical_count);
    println(critical_count);
    for i in 0..critical_count {
        print(critical[i], " ");
    }
    println();
}
