fn main() {
    let n = read();
    let q = read();
    let coin = array(n + 1, 0);
    var root = 1;
    for v in 1..=n {
        coin[v] = read();
        if coin[v] == 1 {
            root = v;
        }
    }
    let head = array(n + 1, -1);
    let to = array(2 * n, 0);
    let next = array(2 * n, 0);
    for e in 0..n - 1 {
        let a = read();
        let b = read();
        to[2 * e] = b;
        next[2 * e] = head[a];
        head[a] = 2 * e;
        to[2 * e + 1] = a;
        next[2 * e + 1] = head[b];
        head[b] = 2 * e + 1;
    }
    var levels = 1;
    while (1 << levels) < n {
        levels += 1;
    }
    levels += 1;
    let stride = n + 1;
    let up = array(levels * stride, 0);
    let depth = array(n + 1, 0);
    let parent = array(n + 1, 0);
    let order = array(n, 0);
    let visited = array(n + 1, 0);
    let stack = array(n, 0);
    var order_size = 0;
    visited[root] = 1;
    up[root] = root;
    var stack_size = 1;
    stack[0] = root;
    while stack_size > 0 {
        stack_size -= 1;
        let u = stack[stack_size];
        order[order_size] = u;
        order_size += 1;
        var e = head[u];
        while e != -1 {
            let v = to[e];
            if visited[v] == 0 {
                visited[v] = 1;
                depth[v] = depth[u] + 1;
                up[v] = u;
                parent[v] = u;
                stack[stack_size] = v;
                stack_size += 1;
            }
            e = next[e];
        }
    }
    for k in 1..levels {
        for v in 1..=n {
            up[k * stride + v] = up[(k - 1) * stride + up[(k - 1) * stride + v]];
        }
    }
    let count = array(n + 1, 0);
    var i = order_size - 1;
    while i >= 0 {
        let u = order[i];
        count[u] += coin[u];
        if parent[u] != 0 {
            count[parent[u]] += count[u];
        }
        i -= 1;
    }
    let in_k = array(n + 1, 0);
    var k_size = 0;
    for v in 1..=n {
        if count[v] > 0 {
            in_k[v] = 1;
            k_size += 1;
        }
    }
    let entry = array(n + 1, 0);
    for idx in 0..order_size {
        let u = order[idx];
        if in_k[u] == 1 {
            entry[u] = u;
        } else {
            entry[u] = entry[parent[u]];
        }
    }
    let dk = array(n + 1, 0);
    for v in 1..=n {
        dk[v] = depth[v] - depth[entry[v]];
    }
    let ck = k_size - 1;
    for query in 0..q {
        let a = read();
        let b = read();
        var u = a;
        var v = b;
        if depth[u] < depth[v] {
            let temporary = u;
            u = v;
            v = temporary;
        }
        var difference = depth[u] - depth[v];
        var k = 0;
        while k < levels {
            if ((difference >> k) & 1) == 1 {
                u = up[k * stride + u];
            }
            k += 1;
        }
        var lca = u;
        if u != v {
            var k2 = levels - 1;
            while k2 >= 0 {
                if up[k2 * stride + u] != up[k2 * stride + v] {
                    u = up[k2 * stride + u];
                    v = up[k2 * stride + v];
                }
                k2 -= 1;
            }
            lca = up[u];
        }
        let distance = depth[a] + depth[b] - 2 * depth[lca];
        var extra = ck + dk[a] + dk[b];
        if entry[a] == entry[b] {
            extra -= (dk[a] + dk[b] - distance) / 2;
        }
        println(2 * extra - distance);
    }
}
