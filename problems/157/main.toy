fn main() {
    let nodes = read();
    let edge_count = nodes - 1;
    let head = array(nodes + 1, -1);
    let to = array(2 * edge_count, 0);
    let next = array(2 * edge_count, 0);
    for edge in 0..edge_count {
        let first = read();
        let second = read();
        to[2 * edge] = second;
        next[2 * edge] = head[first];
        head[first] = 2 * edge;
        to[2 * edge + 1] = first;
        next[2 * edge + 1] = head[second];
        head[second] = 2 * edge + 1;
    }
    let parent = array(nodes + 1, 0);
    let order = array(nodes, 0);
    root_tree(nodes, 1, head, to, next, parent, order);
    let subtree = array(nodes + 1, 1);
    let largest_child = array(nodes + 1, 0);
    var index = nodes;
    while index > 0 {
        index -= 1;
        let node = order[index];
        if parent[node] > 0 {
            subtree[parent[node]] += subtree[node];
            if subtree[node] > largest_child[parent[node]] {
                largest_child[parent[node]] = subtree[node];
            }
        }
    }
    var centroid = 1;
    var found = false;
    for node in 1..=nodes {
        if !found {
            var largest = nodes - subtree[node];
            if largest_child[node] > largest {
                largest = largest_child[node];
            }
            if largest <= nodes / 2 {
                centroid = node;
                found = true;
            }
        }
    }
    println(centroid);
}