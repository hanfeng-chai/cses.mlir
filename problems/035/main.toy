fn main() {
    let count = read();
    let positions = array(count + 1, 0);
    for index in 1..=count {
        positions[read()] = index;
    }
    var rounds = 1;
    for value in 2..=count {
        if positions[value] < positions[value - 1] {
            rounds += 1;
        }
    }
    println(rounds);
}