fn main() {
    let n = read();
    var size = n + 1;
    if size < 4 {
        size = 4;
    }
    let a = array(size, 0);
    a[0] = 1;
    if n >= 1 {
        a[1] = 1;
    }
    for i in 4..=n {
        var value = (i + 1) % 1000000007 * a[i - 1]
            - (i - 2) % 1000000007 * a[i - 2]
            - (i - 5) % 1000000007 * a[i - 3]
            + (i - 3) % 1000000007 * a[i - 4];
        value = value % 1000000007;
        if value < 0 {
            value += 1000000007;
        }
        a[i] = value;
    }
    println(a[n]);
}
