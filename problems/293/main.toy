fn put3(id: array<i64>, mw: i64, cnt: array<i64>, r: i64, c: i64, r1: i64, c1: i64, r2: i64, c2: i64, r3: i64, c3: i64) {
    let value = cnt[0];
    cnt[0] += 1;
    id[(r + r1) * mw + c + c1] = value;
    id[(r + r2) * mw + c + c2] = value;
    id[(r + r3) * mw + c + c3] = value;
}

fn block2x3(id: array<i64>, mw: i64, cnt: array<i64>, r: i64, c: i64) {
    put3(id, mw, cnt, r, c, 0, 0, 1, 0, 1, 1);
    put3(id, mw, cnt, r, c, 0, 1, 0, 2, 1, 2);
}

fn block3x2(id: array<i64>, mw: i64, cnt: array<i64>, r: i64, c: i64) {
    put3(id, mw, cnt, r, c, 0, 0, 0, 1, 1, 1);
    put3(id, mw, cnt, r, c, 1, 0, 2, 0, 2, 1);
}

fn seed5x9(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64) {
    put3(id, mw, cnt, r0, c0, 0, 0, 1, 0, 1, 1);
    put3(id, mw, cnt, r0, c0, 0, 1, 0, 2, 1, 2);
    put3(id, mw, cnt, r0, c0, 0, 3, 0, 4, 1, 3);
    put3(id, mw, cnt, r0, c0, 0, 5, 0, 6, 1, 5);
    put3(id, mw, cnt, r0, c0, 0, 7, 0, 8, 1, 8);
    put3(id, mw, cnt, r0, c0, 1, 4, 2, 4, 2, 5);
    put3(id, mw, cnt, r0, c0, 1, 6, 1, 7, 2, 6);
    put3(id, mw, cnt, r0, c0, 2, 0, 2, 1, 3, 1);
    put3(id, mw, cnt, r0, c0, 2, 2, 2, 3, 3, 3);
    put3(id, mw, cnt, r0, c0, 2, 7, 2, 8, 3, 8);
    put3(id, mw, cnt, r0, c0, 3, 0, 4, 0, 4, 1);
    put3(id, mw, cnt, r0, c0, 3, 2, 4, 2, 4, 3);
    put3(id, mw, cnt, r0, c0, 3, 4, 4, 4, 4, 5);
    put3(id, mw, cnt, r0, c0, 3, 5, 3, 6, 4, 6);
    put3(id, mw, cnt, r0, c0, 3, 7, 4, 7, 4, 8);
}

fn seed9x5(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64) {
    put3(id, mw, cnt, r0, c0, 0, 0, 0, 1, 1, 1);
    put3(id, mw, cnt, r0, c0, 1, 0, 2, 0, 2, 1);
    put3(id, mw, cnt, r0, c0, 3, 0, 4, 0, 3, 1);
    put3(id, mw, cnt, r0, c0, 5, 0, 6, 0, 5, 1);
    put3(id, mw, cnt, r0, c0, 7, 0, 8, 0, 8, 1);
    put3(id, mw, cnt, r0, c0, 4, 1, 4, 2, 5, 2);
    put3(id, mw, cnt, r0, c0, 6, 1, 7, 1, 6, 2);
    put3(id, mw, cnt, r0, c0, 0, 2, 1, 2, 1, 3);
    put3(id, mw, cnt, r0, c0, 2, 2, 3, 2, 3, 3);
    put3(id, mw, cnt, r0, c0, 7, 2, 8, 2, 8, 3);
    put3(id, mw, cnt, r0, c0, 0, 3, 0, 4, 1, 4);
    put3(id, mw, cnt, r0, c0, 2, 3, 2, 4, 3, 4);
    put3(id, mw, cnt, r0, c0, 4, 3, 4, 4, 5, 4);
    put3(id, mw, cnt, r0, c0, 5, 3, 6, 3, 6, 4);
    put3(id, mw, cnt, r0, c0, 7, 3, 7, 4, 8, 4);
}

fn fill5x6(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64) {
    block2x3(id, mw, cnt, r0, c0);
    block2x3(id, mw, cnt, r0, c0 + 3);
    block3x2(id, mw, cnt, r0 + 2, c0);
    block3x2(id, mw, cnt, r0 + 2, c0 + 2);
    block3x2(id, mw, cnt, r0 + 2, c0 + 4);
}

fn fill6x5(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64) {
    block3x2(id, mw, cnt, r0, c0);
    block3x2(id, mw, cnt, r0 + 3, c0);
    block2x3(id, mw, cnt, r0, c0 + 2);
    block2x3(id, mw, cnt, r0 + 2, c0 + 2);
    block2x3(id, mw, cnt, r0 + 4, c0 + 2);
}

fn fill5byM(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64, M: i64) {
    var c = c0;
    var mm = M;
    if mm % 6 == 3 {
        seed5x9(id, mw, cnt, r0, c);
        c += 9;
        mm -= 9;
    }
    while mm > 0 {
        fill5x6(id, mw, cnt, r0, c);
        mm -= 6;
        c += 6;
    }
}

fn fillNby5(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64, N: i64) {
    var r = r0;
    var nn = N;
    if nn % 6 == 3 {
        seed9x5(id, mw, cnt, r, c0);
        r += 9;
        nn -= 9;
    }
    while nn > 0 {
        fill6x5(id, mw, cnt, r, c0);
        nn -= 6;
        r += 6;
    }
}

fn fill(id: array<i64>, mw: i64, cnt: array<i64>, r0: i64, c0: i64, N: i64, M: i64) {
    if N == 2 {
        for c in 0..M {
            if c % 3 == 0 {
                block2x3(id, mw, cnt, r0, c0 + c);
            }
        }
        return;
    }
    if M == 2 {
        for r in 0..N {
            if r % 3 == 0 {
                block3x2(id, mw, cnt, r0 + r, c0);
            }
        }
        return;
    }
    if N == 3 {
        for c in 0..M {
            if c % 2 == 0 {
                block3x2(id, mw, cnt, r0, c0 + c);
            }
        }
        return;
    }
    if M == 3 {
        for r in 0..N {
            if r % 2 == 0 {
                block2x3(id, mw, cnt, r0 + r, c0);
            }
        }
        return;
    }
    if N % 2 == 0 && M % 3 == 0 {
        for r in 0..N {
            if r % 2 == 0 {
                for c in 0..M {
                    if c % 3 == 0 {
                        block2x3(id, mw, cnt, r0 + r, c0 + c);
                    }
                }
            }
        }
        return;
    }
    if M % 2 == 0 && N % 3 == 0 {
        for r in 0..N {
            if r % 3 == 0 {
                for c in 0..M {
                    if c % 2 == 0 {
                        block3x2(id, mw, cnt, r0 + r, c0 + c);
                    }
                }
            }
        }
        return;
    }
    if N % 2 == 0 {
        for r in 0..N {
            if r % 3 == 0 {
                block3x2(id, mw, cnt, r0 + r, c0);
            }
        }
        fill(id, mw, cnt, r0, c0 + 2, N, M - 2);
        return;
    }
    if M % 2 == 0 {
        for c in 0..M {
            if c % 3 == 0 {
                block2x3(id, mw, cnt, r0, c0 + c);
            }
        }
        fill(id, mw, cnt, r0 + 2, c0, N - 2, M);
        return;
    }
    if M % 3 == 0 {
        fill5byM(id, mw, cnt, r0, c0, M);
        if N > 5 {
            fill(id, mw, cnt, r0 + 5, c0, N - 5, M);
        }
    } else {
        fillNby5(id, mw, cnt, r0, c0, N);
        if M > 5 {
            fill(id, mw, cnt, r0, c0 + 5, N, M - 5);
        }
    }
}

fn main() {
    let tests = read();
    for test_case in 0..tests {
        let n = read();
        let m = read();
        let ok = n >= 2 && m >= 2 && (n * m) % 3 == 0 && !(n == 3 && m % 2 == 1) && !(m == 3 && n % 2 == 1);
        if !ok {
            println("NO");
        } else {
            let id = array(n * m, -1);
            let cnt = array(1, 0);
            fill(id, m, cnt, 0, 0, n, m);
            let total = cnt[0];
            let adj_head = array(total, -1);
            let adj_to = array(4 * n * m + 10, 0);
            let adj_next = array(4 * n * m + 10, 0);
            var adj_size = 0;
            for i in 0..n {
                for j in 0..m {
                    if i + 1 < n && id[i * m + j] != id[(i + 1) * m + j] {
                        adj_to[adj_size] = id[(i + 1) * m + j];
                        adj_next[adj_size] = adj_head[id[i * m + j]];
                        adj_head[id[i * m + j]] = adj_size;
                        adj_size += 1;
                        adj_to[adj_size] = id[i * m + j];
                        adj_next[adj_size] = adj_head[id[(i + 1) * m + j]];
                        adj_head[id[(i + 1) * m + j]] = adj_size;
                        adj_size += 1;
                    }
                    if j + 1 < m && id[i * m + j] != id[i * m + j + 1] {
                        adj_to[adj_size] = id[i * m + j + 1];
                        adj_next[adj_size] = adj_head[id[i * m + j]];
                        adj_head[id[i * m + j]] = adj_size;
                        adj_size += 1;
                        adj_to[adj_size] = id[i * m + j];
                        adj_next[adj_size] = adj_head[id[i * m + j + 1]];
                        adj_head[id[i * m + j + 1]] = adj_size;
                        adj_size += 1;
                    }
                }
            }
            let color = array(total, -1);
            let used = array(26, 0);
            for v in 0..total {
                var e = adj_head[v];
                while e != -1 {
                    let u = adj_to[e];
                    if color[u] >= 0 {
                        used[color[u]] = 1;
                    }
                    e = adj_next[e];
                }
                var chosen = 0;
                while used[chosen] == 1 {
                    chosen += 1;
                }
                color[v] = chosen;
                var e2 = adj_head[v];
                while e2 != -1 {
                    let u2 = adj_to[e2];
                    if color[u2] >= 0 {
                        used[color[u2]] = 0;
                    }
                    e2 = adj_next[e2];
                }
            }
            println("YES");
            for i in 0..n {
                for j in 0..m {
                    put('A' + color[id[i * m + j]]);
                }
                println();
            }
        }
    }
}
