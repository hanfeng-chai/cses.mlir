fn sift_slice(values: array<i64>, start: i64, count: i64) {
    var index = start;
    while 2 * index + 1 < count {
        var child = 2 * index + 1;
        if child + 1 < count && values[child + 1] > values[child] {
            child += 1;
        }
        if values[child] <= values[index] {
            return;
        }
        let temporary = values[index];
        values[index] = values[child];
        values[child] = temporary;
        index = child;
    }
}

fn heap_sort_slice(values: array<i64>, count: i64) {
    var begin = count / 2;
    while begin > 0 {
        begin -= 1;
        sift_slice(values, begin, count);
    }
    var end = count;
    while end > 1 {
        end -= 1;
        let temporary = values[0];
        values[0] = values[end];
        values[end] = temporary;
        sift_slice(values, 0, end);
    }
}

fn main() {
    let n = read();
    let m = read();
    let q = read();
    let head = array(n + 1, -1);
    let to = array(2 * m, 0);
    let next = array(2 * m, 0);
    let edge_id = array(2 * m, 0);
    for e in 0..m {
        let a = read();
        let b = read();
        if a == b {
            continue;
        }
        to[2 * e] = b;
        edge_id[2 * e] = e;
        next[2 * e] = head[a];
        head[a] = 2 * e;
        to[2 * e + 1] = a;
        edge_id[2 * e + 1] = e;
        next[2 * e + 1] = head[b];
        head[b] = 2 * e + 1;
    }
    let disc = array(n + 1, 0);
    let low = array(n + 1, 0);
    let articulation = array(n + 1, 0);
    let cursor = array(n + 1, 0);
    let parent_edge = array(n + 1, -1);
    let stack = array(n, 0);
    let estk_u = array(2 * m + 2, 0);
    let estk_v = array(2 * m + 2, 0);
    let scratch = array(4 * m + 4, 0);
    let bcc_nodes = array(4 * m + 4, 0);
    let bcc_start = array(2 * m + 2, 0);
    let bcc_len = array(2 * m + 2, 0);
    var timer = 0;
    var bcc_count = 0;
    var bcc_total = 0;
    var estk_size = 0;
    for s in 1..=n {
        if disc[s] != 0 {
            continue;
        }
        timer += 1;
        disc[s] = timer;
        low[s] = timer;
        cursor[s] = head[s];
        parent_edge[s] = -1;
        var root_children = 0;
        var stack_size = 1;
        stack[0] = s;
        while stack_size > 0 {
            let u = stack[stack_size - 1];
            let e = cursor[u];
            if e != -1 {
                cursor[u] = next[e];
                let v = to[e];
                let id = edge_id[e];
                if id == parent_edge[u] {
                    continue;
                }
                if disc[v] == 0 {
                    estk_u[estk_size] = u;
                    estk_v[estk_size] = v;
                    estk_size += 1;
                    parent_edge[v] = id;
                    timer += 1;
                    disc[v] = timer;
                    low[v] = timer;
                    if u == s {
                        root_children += 1;
                    }
                    cursor[v] = head[v];
                    stack[stack_size] = v;
                    stack_size += 1;
                } else if disc[v] < disc[u] {
                    estk_u[estk_size] = u;
                    estk_v[estk_size] = v;
                    estk_size += 1;
                    if disc[v] < low[u] {
                        low[u] = disc[v];
                    }
                }
            } else {
                stack_size -= 1;
                if stack_size > 0 {
                    let p = stack[stack_size - 1];
                    if low[u] < low[p] {
                        low[p] = low[u];
                    }
                    if low[u] >= disc[p] {
                        if p != s {
                            articulation[p] = 1;
                        }
                        var count = 0;
                        var popping = true;
                        while popping {
                            estk_size -= 1;
                            scratch[count] = estk_u[estk_size];
                            count += 1;
                            scratch[count] = estk_v[estk_size];
                            count += 1;
                            if estk_u[estk_size] == p && estk_v[estk_size] == u {
                                popping = false;
                            }
                        }
                        heap_sort_slice(scratch, count);
                        var unique_count = 0;
                        var i = 0;
                        while i < count {
                            if unique_count == 0 || scratch[i] != scratch[unique_count - 1] {
                                scratch[unique_count] = scratch[i];
                                unique_count += 1;
                            }
                            i += 1;
                        }
                        bcc_start[bcc_count] = bcc_total;
                        bcc_len[bcc_count] = unique_count;
                        for i in 0..unique_count {
                            bcc_nodes[bcc_total] = scratch[i];
                            bcc_total += 1;
                        }
                        bcc_count += 1;
                    }
                }
            }
        }
        if root_children >= 2 {
            articulation[s] = 1;
        }
    }
    let total_nodes = n + bcc_count;
    let rep = array(n + 1, 0);
    for v in 1..=n {
        if articulation[v] == 1 {
            rep[v] = v;
        }
    }
    let tadj_head = array(total_nodes + 1, -1);
    let tadj_to = array(4 * m + 4, 0);
    let tadj_next = array(4 * m + 4, 0);
    var tadj_edges = 0;
    for i in 0..bcc_count {
        let bnode = n + 1 + i;
        for j in 0..bcc_len[i] {
            let x = bcc_nodes[bcc_start[i] + j];
            if articulation[x] == 1 {
                tadj_to[tadj_edges] = x;
                tadj_next[tadj_edges] = tadj_head[bnode];
                tadj_head[bnode] = tadj_edges;
                tadj_edges += 1;
                tadj_to[tadj_edges] = bnode;
                tadj_next[tadj_edges] = tadj_head[x];
                tadj_head[x] = tadj_edges;
                tadj_edges += 1;
            } else {
                rep[x] = bnode;
            }
        }
    }
    for v in 1..=n {
        if rep[v] == 0 {
            rep[v] = v;
        }
    }
    var levels = 1;
    while (1 << levels) < total_nodes {
        levels += 1;
    }
    levels += 1;
    let stride = total_nodes + 1;
    let up = array(levels * stride, 0);
    let depth = array(total_nodes + 1, 0);
    let visited = array(total_nodes + 1, 0);
    let bfs_queue = array(total_nodes + 1, 0);
    for s in 1..=total_nodes {
        if visited[s] != 0 {
            continue;
        }
        visited[s] = 1;
        up[s] = s;
        var head_index = 0;
        var tail_index = 0;
        bfs_queue[tail_index] = s;
        tail_index += 1;
        while head_index < tail_index {
            let u = bfs_queue[head_index];
            head_index += 1;
            var e = tadj_head[u];
            while e != -1 {
                let v = tadj_to[e];
                if visited[v] == 0 {
                    visited[v] = 1;
                    depth[v] = depth[u] + 1;
                    up[v] = u;
                    bfs_queue[tail_index] = v;
                    tail_index += 1;
                }
                e = tadj_next[e];
            }
        }
    }
    for k in 1..levels {
        for v in 1..=total_nodes {
            up[k * stride + v] = up[(k - 1) * stride + up[(k - 1) * stride + v]];
        }
    }
    for query in 0..q {
        let a = read();
        let b = read();
        let c = read();
        if a == c || b == c {
            println("NO");
            continue;
        }
        if articulation[c] == 0 {
            println("YES");
            continue;
        }
        var u = rep[a];
        var v = rep[b];
        let x = c;
        if depth[u] < depth[v] {
            let temporary = u;
            u = v;
            v = temporary;
        }
        var difference = depth[u] - depth[v];
        var k = 0;
        while k < levels {
            if ((difference >> k) & 1) == 1 {
                u = up[k * stride + u];
            }
            k += 1;
        }
        var lca = u;
        if u != v {
            var k2 = levels - 1;
            while k2 >= 0 {
                if up[k2 * stride + u] != up[k2 * stride + v] {
                    u = up[k2 * stride + u];
                    v = up[k2 * stride + v];
                }
                k2 -= 1;
            }
            lca = up[u];
        }
        var on_path = false;
        if depth[x] >= depth[lca] {
            var node_a = rep[a];
            var node_b = rep[b];
            var d1 = depth[node_a] - depth[x];
            var ancestor_a = node_a;
            var k3 = 0;
            while k3 < levels {
                if ((d1 >> k3) & 1) == 1 {
                    ancestor_a = up[k3 * stride + ancestor_a];
                }
                k3 += 1;
            }
            var d2 = depth[node_b] - depth[x];
            var ancestor_b = node_b;
            var k4 = 0;
            while k4 < levels {
                if ((d2 >> k4) & 1) == 1 {
                    ancestor_b = up[k4 * stride + ancestor_b];
                }
                k4 += 1;
            }
            if ancestor_a == x || ancestor_b == x {
                on_path = true;
            }
        }
        if on_path {
            println("NO");
        } else {
            println("YES");
        }
    }
}
