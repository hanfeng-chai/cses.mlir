fn main() {
    let n = read();
    let m = read();
    let head = array(n + 1, -1);
    let to = array(2 * m, 0);
    let next = array(2 * m, 0);
    let edge_id = array(2 * m, 0);
    let edge_a = array(m, 0);
    let edge_b = array(m, 0);
    for e in 0..m {
        let a = read();
        let b = read();
        edge_a[e] = a;
        edge_b[e] = b;
        to[2 * e] = b;
        next[2 * e] = head[a];
        head[a] = 2 * e;
        edge_id[2 * e] = e;
        to[2 * e + 1] = a;
        next[2 * e + 1] = head[b];
        head[b] = 2 * e + 1;
        edge_id[2 * e + 1] = e;
    }
    let dsu = array(n + 1, 0);
    let dsu_size = array(n + 1, 0);
    for v in 1..=n {
        dsu[v] = v;
        dsu_size[v] = 1;
    }
    for e in 0..m {
        dsu_union(dsu, dsu_size, edge_a[e], edge_b[e]);
    }
    let edge_count = array(n + 1, 0);
    for e in 0..m {
        let root = dsu_find(dsu, edge_a[e]);
        edge_count[root] += 1;
    }
    for v in 1..=n {
        if dsu_find(dsu, v) == v && edge_count[v] % 2 == 1 {
            println("IMPOSSIBLE");
            return;
        }
    }
    let disc = array(n + 1, 0);
    let outdeg = array(n + 1, 0);
    let from = array(m, 0);
    let to_node = array(m, 0);
    let oriented = array(m, 0);
    let cursor = array(n + 1, 0);
    let parent_node = array(n + 1, 0);
    let parent_edge = array(n + 1, -1);
    let stack = array(n, 0);
    var timer = 0;
    for s in 1..=n {
        if disc[s] != 0 {
            continue;
        }
        timer += 1;
        disc[s] = timer;
        cursor[s] = head[s];
        var stack_size = 1;
        stack[0] = s;
        while stack_size > 0 {
            let u = stack[stack_size - 1];
            let e = cursor[u];
            if e == -1 {
                stack_size -= 1;
                let pe = parent_edge[u];
                if pe != -1 {
                    let p = parent_node[u];
                    if outdeg[u] % 2 == 1 {
                        from[pe] = u;
                        to_node[pe] = p;
                        outdeg[u] += 1;
                    } else {
                        from[pe] = p;
                        to_node[pe] = u;
                        outdeg[p] += 1;
                    }
                    oriented[pe] = 1;
                }
            } else {
                cursor[u] = next[e];
                let v = to[e];
                let id = edge_id[e];
                if id != parent_edge[u] {
                    if disc[v] == 0 {
                        timer += 1;
                        disc[v] = timer;
                        parent_node[v] = u;
                        parent_edge[v] = id;
                        cursor[v] = head[v];
                        stack[stack_size] = v;
                        stack_size += 1;
                    } else if oriented[id] == 0 {
                        oriented[id] = 1;
                        from[id] = u;
                        to_node[id] = v;
                        outdeg[u] += 1;
                    }
                }
            }
        }
    }
    for e in 0..m {
        println(from[e], " ", to_node[e]);
    }
}
