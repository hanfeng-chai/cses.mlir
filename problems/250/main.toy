fn main() {
    let n = read();
    let pre = array(n + 1, 0);
    for i in 1..=n {
        pre[i] = pre[i - 1] + read();
    }
    let dp = array((n + 1) * (n + 1), 0);
    let opt = array((n + 1) * (n + 1), i16(0));
    for i in 1..=n {
        opt[i * (n + 1) + i] = i16(i);
    }
    for len in 2..=n {
        for i in 1..=n - len + 1 {
            let j = i + len - 1;
            let w = pre[j] - pre[i - 1];
            var best = 9000000000000000000;
            var best_split = i;
            var lo = i64(opt[i * (n + 1) + j - 1]);
            if lo < i {
                lo = i;
            }
            var hi = i64(opt[(i + 1) * (n + 1) + j]);
            if hi > j - 1 {
                hi = j - 1;
            }
            for split in lo..=hi {
                let value = dp[i * (n + 1) + split] + dp[(split + 1) * (n + 1) + j];
                if value < best {
                    best = value;
                    best_split = split;
                }
            }
            dp[i * (n + 1) + j] = best + w;
            opt[i * (n + 1) + j] = i16(best_split);
        }
    }
    println(dp[1 * (n + 1) + n]);
}
