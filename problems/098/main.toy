fn main() {
    let nodes = read();
    let edges = read();
    let head = array(nodes + 1, -1);
    let to = array(edges, 0);
    let next = array(edges, 0);
    let indegree = array(nodes + 1, 0);
    for edge in 0..edges {
        let source = read();
        to[edge] = read();
        next[edge] = head[source];
        head[source] = edge;
        indegree[to[edge]] += 1;
    }
    let queue = array(nodes, 0);
    var queue_head = 0;
    var queue_tail = 0;
    for node in 1..=nodes {
        if indegree[node] == 0 {
            queue[queue_tail] = node;
            queue_tail += 1;
        }
    }
    let longest = array(nodes + 1, -1);
    let parent = array(nodes + 1, 0);
    longest[1] = 1;
    while queue_head < queue_tail {
        let node = queue[queue_head];
        queue_head += 1;
        var edge = head[node];
        while edge != -1 {
            let neighbor = to[edge];
            if longest[node] != -1 && longest[node] + 1 > longest[neighbor] {
                longest[neighbor] = longest[node] + 1;
                parent[neighbor] = node;
            }
            indegree[neighbor] -= 1;
            if indegree[neighbor] == 0 {
                queue[queue_tail] = neighbor;
                queue_tail += 1;
            }
            edge = next[edge];
        }
    }
    if longest[nodes] == -1 {
        println("IMPOSSIBLE");
    } else {
        let path = array(longest[nodes], 0);
        var size = 0;
        var node = nodes;
        while node != 0 {
            path[size] = node;
            size += 1;
            node = parent[node];
        }
        println(size);
        while size > 0 {
            size -= 1;
            print(path[size], " ");
        }
        println();
    }
}