fn main() {
    let applicant_count = read();
    let apartment_count = read();
    let tolerance = read();
    let applicants = array(applicant_count, 0);
    let apartments = array(apartment_count, 0);
    for index in 0..applicant_count {
        applicants[index] = read();
    }
    for index in 0..apartment_count {
        apartments[index] = read();
    }
    sort(applicants);
    sort(apartments);

    var applicant = 0;
    var apartment = 0;
    var matches = 0;
    while applicant < applicant_count && apartment < apartment_count {
        if absolute(applicants[applicant] - apartments[apartment]) <= tolerance {
            matches += 1;
            applicant += 1;
            apartment += 1;
        } else if applicants[applicant] + tolerance < apartments[apartment] {
            applicant += 1;
        } else {
            apartment += 1;
        }
    }
    println(matches);
}