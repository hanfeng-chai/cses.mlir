fn main() {
    let size = read();
    let queries = read();
    let prefix = array(size + 1, 0);
    for index in 1..=size {
        prefix[index] = prefix[index - 1] ^ read();
    }
    for query in 0..queries {
        let left = read();
        let right = read();
        println(prefix[right] ^ prefix[left - 1]);
    }
}