fn main() {
    let employees = read();
    let queries = read();
    let levels = 20;
    let stride = employees + 1;
    let up = array(levels * stride, 0);
    let depth = array(stride, 0);
    for employee in 2..=employees {
        up[employee] = read();
        depth[employee] = depth[up[employee]] + 1;
    }
    for level in 1..levels {
        for employee in 1..=employees {
            up[level * stride + employee] = up[(level - 1) * stride
                + up[(level - 1) * stride + employee]];
        }
    }
    for query in 0..queries {
        println(tree_lca(up, depth, stride, levels, read(), read()));
    }
}