fn sum_two_squares(value: i64) -> bool {
    var x = value;
    var p = 2;
    var is_ok = true;
    while is_ok && p * p <= x {
        if x % p == 0 {
            var exponent = 0;
            while x % p == 0 {
                x /= p;
                exponent += 1;
            }
            if p % 4 == 3 && exponent % 2 == 1 {
                is_ok = false;
            }
        }
        p += 1;
    }
    if is_ok && x > 1 && x % 4 == 3 {
        is_ok = false;
    }
    return is_ok;
}

fn main() {
    let tests = read();
    for test in 0..tests {
        let n = read();
        let first = 8 * n + 1;
        let root = integer_sqrt(first);
        if root * root == first {
            println(1);
        } else if sum_two_squares(4 * n + 1) {
            println(2);
        } else {
            println(3);
        }
    }
}
