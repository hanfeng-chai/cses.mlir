fn main() {
    let n = read();
    var cur = array(n + 1, 0);
    cur[0] = 1;
    for i in 2..=n {
        let next = array(n + 1, 0);
        for d in 0..i {
            var value = (d + 1) % 1000000007 * cur[d] % 1000000007;
            if d > 0 {
                value += (i - d) % 1000000007 * cur[d - 1] % 1000000007;
                value = value % 1000000007;
            }
            next[d] = value;
        }
        cur = next;
    }
    for k in 1..=n {
        print(cur[k - 1]);
        print(" ");
    }
    print("\n");
}
