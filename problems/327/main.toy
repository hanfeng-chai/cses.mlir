fn process_diagonal(diagonal: i64, n: i64, offsets: array<i64>, color: array<i8>, top_left: array<i16>, bottom_right: array<i16>, expire_head: array<i64>, expire_next: array<i64>, fenwick: array<i16>, stride: i64, answer: array<i64>) {
    let begin = offsets[diagonal];
    let length = offsets[diagonal + 1] - begin;
    for i in 0..=length {
        expire_head[i] = -1;
    }
    for i in 0..length {
        let reach = i64(bottom_right[begin + i]);
        if reach >= 2 && i + reach < length {
            expire_next[i] = expire_head[i + reach];
            expire_head[i + reach] = i;
        }
    }
    for j in 0..length {
        var i = expire_head[j];
        while i != -1 {
            let letter = i64(color[begin + i]);
            var p = i + 1;
            while p <= length {
                fenwick[letter * stride + p] -= i16(1);
                p += p & (0 - p);
            }
            i = expire_next[i];
        }
        let letter = i64(color[begin + j]);
        if i64(bottom_right[begin + j]) >= 2 {
            var p = j + 1;
            while p <= length {
                fenwick[letter * stride + p] += i16(1);
                p += p & (0 - p);
            }
        }
        let reach = i64(top_left[begin + j]);
        if reach >= 2 {
            var minimum_left = j - reach + 1;
            if minimum_left < 0 {
                minimum_left = 0;
            }
            var prefix_j = 0;
            var p = j;
            while p > 0 {
                prefix_j += i64(fenwick[letter * stride + p]);
                p -= p & (0 - p);
            }
            var prefix_left = 0;
            var p2 = minimum_left;
            while p2 > 0 {
                prefix_left += i64(fenwick[letter * stride + p2]);
                p2 -= p2 & (0 - p2);
            }
            answer[letter] += prefix_j - prefix_left;
        }
    }
    for i in 0..length {
        let reach = i64(bottom_right[begin + i]);
        if reach >= 2 && i + reach >= length {
            let letter = i64(color[begin + i]);
            var p = i + 1;
            while p <= length {
                fenwick[letter * stride + p] -= i16(1);
                p += p & (0 - p);
            }
        }
    }
}

fn main() {
    let n = read();
    let k = read();
    let grid = array(n * n, i8(0));
    for y in 0..n {
        let line = read_text();
        for x in 0..n {
            grid[y * n + x] = i8(at(line, x) - 65);
        }
    }
    let offsets = array(2 * n, 0);
    for diagonal in 0..2 * n - 1 {
        let length = if diagonal < n { diagonal + 1 } else { 2 * n - 1 - diagonal };
        offsets[diagonal + 1] = offsets[diagonal] + length;
    }
    let top_left = array(n * n, i16(0));
    let bottom_right = array(n * n, i16(0));
    let color = array(n * n, i8(0));
    let answer = array(k, 0);
    let vertical = array(n, i16(0));
    for y in 0..n {
        var horizontal = 0;
        for x in 0..n {
            if x > 0 && grid[y * n + x] == grid[y * n + x - 1] {
                horizontal += 1;
            } else {
                horizontal = 1;
            }
            if y > 0 && grid[y * n + x] == grid[(y - 1) * n + x] {
                vertical[x] += i16(1);
            } else {
                vertical[x] = i16(1);
            }
            let diagonal = y - x + n - 1;
            let position = offsets[diagonal] + minimum(y, x);
            let top_reach = i64(vertical[x]);
            if horizontal < top_reach {
                top_left[position] = i16(horizontal);
            } else {
                top_left[position] = i16(top_reach);
            }
            color[position] = grid[y * n + x];
            answer[i64(color[position])] += 1;
        }
    }
    for x in 0..n {
        vertical[x] = i16(0);
    }
    var y = n - 1;
    while y >= 0 {
        var horizontal = 0;
        var x = n - 1;
        while x >= 0 {
            if x + 1 < n && grid[y * n + x] == grid[y * n + x + 1] {
                horizontal += 1;
            } else {
                horizontal = 1;
            }
            if y + 1 < n && grid[y * n + x] == grid[(y + 1) * n + x] {
                vertical[x] += i16(1);
            } else {
                vertical[x] = i16(1);
            }
            let diagonal = y - x + n - 1;
            let position = offsets[diagonal] + minimum(y, x);
            let bottom_reach = i64(vertical[x]);
            if horizontal < bottom_reach {
                bottom_right[position] = i16(horizontal);
            } else {
                bottom_right[position] = i16(bottom_reach);
            }
            x -= 1;
        }
        y -= 1;
    }
    let expire_head = array(n + 1, -1);
    let expire_next = array(n, -1);
    let fenwick = array(k * (n + 1), i16(0));
    for diagonal in 0..2 * n - 1 {
        process_diagonal(diagonal, n, offsets, color, top_left, bottom_right, expire_head, expire_next, fenwick, n + 1, answer);
    }
    for letter in 0..k {
        println(answer[letter]);
    }
}
