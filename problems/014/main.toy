fn hanoi(disks: i64, source: i64, destination: i64, spare: i64) {
    if disks > 0 {
        hanoi(disks - 1, source, spare, destination);
        println(source, " ", destination);
        hanoi(disks - 1, spare, destination, source);
    }
}

fn main() {
    let disks = read();
    println((1 << disks) - 1);
    hanoi(disks, 1, 3, 2);
}