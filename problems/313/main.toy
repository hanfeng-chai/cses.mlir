fn main() {
    let n = read();
    let m = read();
    let head = array(n + 1, -1);
    let to = array(m, 0);
    let next = array(m, 0);
    let request_a = array(m, 0);
    let request_b = array(m, 0);
    for e in 0..m {
        let a = read();
        let b = read();
        request_a[e] = a;
        request_b[e] = b;
        to[e] = b;
        next[e] = head[a];
        head[a] = e;
    }
    let comp = array(n + 1, -1);
    let low = array(n + 1, 0);
    let disc = array(n + 1, 0);
    let on_stack = array(n + 1, 0);
    let cursor = array(n + 1, 0);
    let stack = array(n, 0);
    let dfs = array(n, 0);
    var timer = 0;
    var scc_count = 0;
    var stack_size = 0;
    for s in 1..=n {
        if disc[s] != 0 {
            continue;
        }
        var dfs_size = 1;
        dfs[0] = s;
        while dfs_size > 0 {
            let u = dfs[dfs_size - 1];
            if disc[u] == 0 {
                timer += 1;
                disc[u] = timer;
                low[u] = timer;
                cursor[u] = head[u];
                stack[stack_size] = u;
                stack_size += 1;
                on_stack[u] = 1;
            }
            var pushed = false;
            while cursor[u] != -1 && !pushed {
                let e = cursor[u];
                cursor[u] = next[e];
                let w = to[e];
                if disc[w] == 0 {
                    dfs[dfs_size] = w;
                    dfs_size += 1;
                    pushed = true;
                } else if on_stack[w] == 1 {
                    if disc[w] < low[u] {
                        low[u] = disc[w];
                    }
                }
            }
            if pushed {
                continue;
            }
            if low[u] == disc[u] {
                var popping = true;
                while popping {
                    stack_size -= 1;
                    let x = stack[stack_size];
                    on_stack[x] = 0;
                    comp[x] = scc_count;
                    if x == u {
                        popping = false;
                    }
                }
                scc_count += 1;
            }
            dfs_size -= 1;
            if dfs_size > 0 {
                let p = dfs[dfs_size - 1];
                if low[u] < low[p] {
                    low[p] = low[u];
                }
            }
        }
    }
    let scc_size = array(scc_count, 0);
    for v in 1..=n {
        scc_size[comp[v]] += 1;
    }
    let parent = array(n + 1, 0);
    for v in 1..=n {
        parent[v] = v;
    }
    for e in 0..m {
        let ra = dsu_find(parent, request_a[e]);
        let rb = dsu_find(parent, request_b[e]);
        if ra != rb {
            parent[ra] = rb;
        }
    }
    var components = 0;
    for v in 1..=n {
        if dsu_find(parent, v) == v {
            components += 1;
        }
    }
    let has_cycle = array(n + 1, 0);
    for v in 1..=n {
        if scc_size[comp[v]] >= 2 {
            has_cycle[dsu_find(parent, v)] = 1;
        }
    }
    var cyclic_components = 0;
    for v in 1..=n {
        if dsu_find(parent, v) == v && has_cycle[v] == 1 {
            cyclic_components += 1;
        }
    }
    println(n - components + cyclic_components);
}
