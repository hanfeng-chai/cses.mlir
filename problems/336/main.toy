fn combination(fact: array<i64>, inv: array<i64>, a: i64, b: i64) -> i64 {
    if b < 0 || b > a || a < 0 {
        return 0;
    }
    return fact[a] * inv[b] % 1000000007 * inv[a - b] % 1000000007;
}

fn arrange(fact: array<i64>, inv: array<i64>, pool: i64, j: i64, s: i64) -> i64 {
    var value = 0;
    for t in 0..=j {
        let term = combination(fact, inv, j, t) * fact[pool - s - t] % 1000000007;
        if t % 2 == 1 {
            value = (value - term + 1000000007) % 1000000007;
        } else {
            value = (value + term) % 1000000007;
        }
    }
    return value;
}

fn main() {
    let n = read();
    var pos_a = array(n, 0);
    var pos_b = array(n, 0);
    for i in 0..n {
        pos_a[i] = -1;
        pos_b[i] = -1;
    }
    var col_has_a = array(n, 0);
    var col_has_b = array(n, 0);
    for i in 0..n {
        let line = read_text();
        for j in 0..n {
            if at(line, j) == 65 {
                pos_a[i] = j;
                col_has_a[j] = 1;
            } else if at(line, j) == 66 {
                pos_b[i] = j;
                col_has_b[j] = 1;
            }
        }
    }

    var n_a = 0;
    var n_b = 0;
    var n_n = 0;
    var a_only = array(n, 0);
    var b_only = array(n, 0);
    for i in 0..n {
        if pos_a[i] >= 0 && pos_b[i] >= 0 {
        } else if pos_a[i] >= 0 {
            a_only[n_a] = pos_a[i];
            n_a += 1;
        } else if pos_b[i] >= 0 {
            b_only[n_b] = pos_b[i];
            n_b += 1;
        } else {
            n_n += 1;
        }
    }

    let up = n_b + n_n;
    let uq = n_a + n_n;
    var jp = 0;
    for t in 0..n_b {
        if col_has_a[b_only[t]] == 0 {
            jp += 1;
        }
    }
    var jq = 0;
    for t in 0..n_a {
        if col_has_b[a_only[t]] == 0 {
            jq += 1;
        }
    }
    var c = 0;
    for col in 0..n {
        if col_has_a[col] == 0 && col_has_b[col] == 0 {
            c += 1;
        }
    }

    let fact = array(n + 1, 0);
    let inv = array(n + 1, 0);
    fact[0] = 1;
    for i in 1..=n {
        fact[i] = fact[i - 1] * i % 1000000007;
    }
    inv[n] = pow_mod(fact[n], 1000000005, 1000000007);
    for i in n..=1 by -1 {
        inv[i - 1] = inv[i] * i % 1000000007;
    }

    var ans = 0;
    let smax = minimum(n_n, c);
    var falling = 1;
    for s in 0..=smax {
        if s > 0 {
            falling = falling * (c - s + 1) % 1000000007;
        }
        let term = combination(fact, inv, n_n, s) * falling % 1000000007
            * arrange(fact, inv, up, jp, s) % 1000000007
            * arrange(fact, inv, uq, jq, s) % 1000000007;
        if s % 2 == 1 {
            ans = (ans - term + 1000000007) % 1000000007;
        } else {
            ans = (ans + term) % 1000000007;
        }
    }
    println(ans);
}
