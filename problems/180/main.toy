fn main() {
    let index = read();
    let modulus = 1_000_000_007;
    var current = 0;
    var next = 1;
    var bit = 63;
    while bit > 0 {
        bit -= 1;
        let doubled = current * ((2 * next - current + modulus) % modulus) % modulus;
        let adjacent = (current * current % modulus + next * next % modulus) % modulus;
        if ((index >> bit) & 1) == 0 {
            current = doubled;
            next = adjacent;
        } else {
            current = adjacent;
            next = (doubled + adjacent) % modulus;
        }
    }
    println(current);
}