fn main() {
    let n = read();
    let a = read_array(n);
    let b = read_array(n);
    var c = array(n * n, 0);
    for r in 0..n {
        for col in 0..n {
            c[r * n + col] = read();
        }
    }

    let node_count = 2 * n + 2;
    let source = 2 * n;
    let sink = 2 * n + 1;
    let max_edges = 2 * (2 * n + n * n) + 10;
    var head = array(node_count, 0);
    for i in 0..node_count {
        head[i] = -1;
    }
    let to = array(max_edges, 0);
    let cap = array(max_edges, 0);
    let cost = array(max_edges, 0);
    let next_edge = array(max_edges, 0);
    var edge_count = 0;
    var need_flow = 0;

    // source -> row i
    for i in 0..n {
        to[edge_count] = i;
        cap[edge_count] = a[i];
        cost[edge_count] = 0;
        next_edge[edge_count] = head[source];
        head[source] = edge_count;
        edge_count += 1;
        to[edge_count] = source;
        cap[edge_count] = 0;
        cost[edge_count] = 0;
        next_edge[edge_count] = head[i];
        head[i] = edge_count;
        edge_count += 1;
        need_flow += a[i];
    }
    // column j -> sink
    for j in 0..n {
        to[edge_count] = sink;
        cap[edge_count] = b[j];
        cost[edge_count] = 0;
        next_edge[edge_count] = head[n + j];
        head[n + j] = edge_count;
        edge_count += 1;
        to[edge_count] = n + j;
        cap[edge_count] = 0;
        cost[edge_count] = 0;
        next_edge[edge_count] = head[sink];
        head[sink] = edge_count;
        edge_count += 1;
    }
    // row i -> col j, cap 1, cost -c
    for i in 0..n {
        for j in 0..n {
            to[edge_count] = n + j;
            cap[edge_count] = 1;
            cost[edge_count] = 0 - c[i * n + j];
            next_edge[edge_count] = head[i];
            head[i] = edge_count;
            edge_count += 1;
            to[edge_count] = i;
            cap[edge_count] = 0;
            cost[edge_count] = c[i * n + j];
            next_edge[edge_count] = head[n + j];
            head[n + j] = edge_count;
            edge_count += 1;
        }
    }

    let inf = 4000000000000000000;
    var dist = array(node_count, 0);
    var prev_node = array(node_count, 0);
    var prev_edge = array(node_count, 0);
    var in_queue = array(node_count, 0);
    let queue = array(node_count + 1, 0);
    var total_flow = 0;
    var total_cost = 0;

    while true {
        for v in 0..node_count {
            dist[v] = inf;
            prev_node[v] = -1;
            prev_edge[v] = -1;
            in_queue[v] = 0;
        }
        dist[source] = 0;
        var q_head = 0;
        var q_tail = 0;
        queue[q_tail] = source;
        q_tail += 1;
        in_queue[source] = 1;
        while q_head != q_tail {
            let u = queue[q_head];
            q_head += 1;
            if q_head > node_count {
                q_head = 0;
            }
            in_queue[u] = 0;
            var edge = head[u];
            while edge != -1 {
                let v = to[edge];
                if cap[edge] > 0 && dist[u] + cost[edge] < dist[v] {
                    dist[v] = dist[u] + cost[edge];
                    prev_node[v] = u;
                    prev_edge[v] = edge;
                    if in_queue[v] == 0 {
                        in_queue[v] = 1;
                        queue[q_tail] = v;
                        q_tail += 1;
                        if q_tail > node_count {
                            q_tail = 0;
                        }
                    }
                }
                edge = next_edge[edge];
            }
        }
        if dist[sink] >= inf {
            break;
        }
        var push = inf;
        var v = sink;
        while v != source {
            if cap[prev_edge[v]] < push {
                push = cap[prev_edge[v]];
            }
            v = prev_node[v];
        }
        v = sink;
        while v != source {
            let edge = prev_edge[v];
            cap[edge] -= push;
            cap[edge ^ 1] += push;
            v = prev_node[v];
        }
        total_flow += push;
        total_cost += push * dist[sink];
    }

    if total_flow != need_flow {
        println(-1);
        return;
    }
    println(0 - total_cost);
    var grid = array(n * n, 0);
    for i in 0..n {
        var edge = head[i];
        while edge != -1 {
            let v = to[edge];
            if v >= n && v < 2 * n && cap[edge] == 0 {
                grid[i * n + (v - n)] = 1;
            }
            edge = next_edge[edge];
        }
    }
    for r in 0..n {
        for col in 0..n {
            if grid[r * n + col] == 1 {
                put(88);
            } else {
                put(46);
            }
        }
        put(10);
    }
}
