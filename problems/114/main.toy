fn inside(row: i64, column: i64) -> bool {
    return row >= 0 && row < 8 && column >= 0 && column < 8;
}

fn onward(
    row: i64,
    column: i64,
    board: array<i64>,
    delta_row: array<i64>,
    delta_column: array<i64>
) -> i64 {
    var count = 0;
    for direction in 0..8 {
        let next_row = row + delta_row[direction];
        let next_column = column + delta_column[direction];
        if inside(next_row, next_column) && board[next_row * 8 + next_column] == 0 {
            count += 1;
        }
    }
    return count;
}

fn knight_tour(
    row: i64,
    column: i64,
    step: i64,
    board: array<i64>,
    delta_row: array<i64>,
    delta_column: array<i64>,
    candidate_count: array<i64>,
    candidate_row: array<i64>,
    candidate_column: array<i64>
) -> bool {
    board[row * 8 + column] = step;
    var found = step == 64;
    if !found {
        let offset = (step - 1) * 8;
        var count = 0;
        for direction in 0..8 {
            let next_row = row + delta_row[direction];
            let next_column = column + delta_column[direction];
            if inside(next_row, next_column) && board[next_row * 8 + next_column] == 0 {
                candidate_count[offset + count] = onward(
                    next_row, next_column, board, delta_row, delta_column
                );
                candidate_row[offset + count] = next_row;
                candidate_column[offset + count] = next_column;
                count += 1;
            }
        }
        for first in 0..count {
            var best = first;
            for second in first + 1..count {
                let second_is_better = candidate_count[offset + second] < candidate_count[offset + best]
                    || (candidate_count[offset + second] == candidate_count[offset + best]
                        && candidate_row[offset + second] < candidate_row[offset + best])
                    || (candidate_count[offset + second] == candidate_count[offset + best]
                        && candidate_row[offset + second] == candidate_row[offset + best]
                        && candidate_column[offset + second] < candidate_column[offset + best]);
                if second_is_better {
                    best = second;
                }
            }
            let saved_count = candidate_count[offset + first];
            let saved_row = candidate_row[offset + first];
            let saved_column = candidate_column[offset + first];
            candidate_count[offset + first] = candidate_count[offset + best];
            candidate_row[offset + first] = candidate_row[offset + best];
            candidate_column[offset + first] = candidate_column[offset + best];
            candidate_count[offset + best] = saved_count;
            candidate_row[offset + best] = saved_row;
            candidate_column[offset + best] = saved_column;
        }
        var candidate = 0;
        while candidate < count && !found {
            found = knight_tour(
                candidate_row[offset + candidate], candidate_column[offset + candidate], step + 1,
                board, delta_row, delta_column,
                candidate_count, candidate_row, candidate_column
            );
            candidate += 1;
        }
        if !found {
            board[row * 8 + column] = 0;
        }
    }
    return found;
}

fn main() {
    let start_column = read() - 1;
    let start_row = read() - 1;
    let board = array(64, 0);
    let delta_row = array(8, 0);
    let delta_column = array(8, 0);
    delta_row[0] = -2;
    delta_column[0] = -1;
    delta_row[1] = -2;
    delta_column[1] = 1;
    delta_row[2] = -1;
    delta_column[2] = -2;
    delta_row[3] = -1;
    delta_column[3] = 2;
    delta_row[4] = 1;
    delta_column[4] = -2;
    delta_row[5] = 1;
    delta_column[5] = 2;
    delta_row[6] = 2;
    delta_column[6] = -1;
    delta_row[7] = 2;
    delta_column[7] = 1;
    let candidate_count = array(64 * 8, 0);
    let candidate_row = array(64 * 8, 0);
    let candidate_column = array(64 * 8, 0);
    knight_tour(
        start_row, start_column, 1, board, delta_row, delta_column,
        candidate_count, candidate_row, candidate_column
    );
    for row in 0..8 {
        for column in 0..8 {
            print(board[row * 8 + column], " ");
        }
        println();
    }
}