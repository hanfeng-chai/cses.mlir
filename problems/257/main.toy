fn main() {
    let n = read();
    let a = array((n + 1) * (n + 1), 0);
    for i in 1..=n {
        for j in 1..=n {
            a[i * (n + 1) + j] = read();
        }
    }
    let u = array(n + 1, 0);
    let v = array(n + 1, 0);
    let p = array(n + 1, 0);
    let way = array(n + 1, 0);
    let minv = array(n + 1, 0);
    let used = array(n + 1, 0);
    for i in 1..=n {
        p[0] = i;
        var j0 = 0;
        for j in 0..=n {
            minv[j] = 1000000000000000000;
            used[j] = 0;
        }
        var searching = true;
        while searching {
            used[j0] = 1;
            let i0 = p[j0];
            var j1 = -1;
            var delta = 1000000000000000000;
            for j in 1..=n {
                if used[j] == 0 {
                    let current = a[i0 * (n + 1) + j] - u[i0] - v[j];
                    if current < minv[j] {
                        minv[j] = current;
                        way[j] = j0;
                    }
                    if minv[j] < delta {
                        delta = minv[j];
                        j1 = j;
                    }
                }
            }
            for j in 0..=n {
                if used[j] == 1 {
                    u[p[j]] += delta;
                    v[j] -= delta;
                } else {
                    minv[j] -= delta;
                }
            }
            j0 = j1;
            if p[j0] == 0 {
                searching = false;
            }
        }
        while j0 != 0 {
            let j1 = way[j0];
            p[j0] = p[j1];
            j0 = j1;
        }
    }
    var cost = 0;
    for j in 1..=n {
        cost += a[p[j] * (n + 1) + j];
    }
    println(cost);
    for j in 1..=n {
        println(p[j], " ", j);
    }
}
