fn main() {
    let n = read();
    var total = 0;
    var b = 0;
    while (1 << b) <= n {
        let cycle = 1 << (b + 1);
        let half = 1 << b;
        var remainder = (n + 1) % cycle - half;
        if remainder < 0 {
            remainder = 0;
        }
        total += (n + 1) / cycle * half + remainder;
        b += 1;
    }
    println(total);
}
