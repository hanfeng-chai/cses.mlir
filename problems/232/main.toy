fn sweep_update(node: i64, lo: i64, hi: i64, ql: i64, qr: i64, delta: i64, count: array<i64>, covered: array<i64>, ys: array<i64>) {
    if qr <= lo || hi <= ql {
        return;
    }
    if ql <= lo && hi <= qr {
        count[node] += delta;
    } else {
        let mid = (lo + hi) / 2;
        sweep_update(2 * node, lo, mid, ql, qr, delta, count, covered, ys);
        sweep_update(2 * node + 1, mid, hi, ql, qr, delta, count, covered, ys);
    }
    if count[node] > 0 {
        covered[node] = ys[hi] - ys[lo];
    } else if hi - lo == 1 {
        covered[node] = 0;
    } else {
        covered[node] = covered[2 * node] + covered[2 * node + 1];
    }
}

fn main() {
    let n = read();
    let event_x = array(2 * n, 0);
    let event_y1 = array(2 * n, 0);
    let event_y2 = array(2 * n, 0);
    let event_delta = array(2 * n, 0);
    let ys = array(2 * n, 0);
    for i in 0..n {
        let x1 = read();
        let y1 = read();
        let x2 = read();
        let y2 = read();
        event_x[2 * i] = x1;
        event_y1[2 * i] = y1;
        event_y2[2 * i] = y2;
        event_delta[2 * i] = 1;
        event_x[2 * i + 1] = x2;
        event_y1[2 * i + 1] = y1;
        event_y2[2 * i + 1] = y2;
        event_delta[2 * i + 1] = -1;
        ys[2 * i] = y1;
        ys[2 * i + 1] = y2;
    }
    sort(ys);
    let interval_count = unique_sorted(ys, 2 * n) - 1;
    let key = array(2 * n, 0);
    let order = array(2 * n, 0);
    for i in 0..2 * n {
        key[i] = event_x[i];
        order[i] = i;
    }
    sort_pairs(key, order);
    let count = array(4 * (interval_count + 1), 0);
    let covered = array(4 * (interval_count + 1), 0);
    var area = 0;
    var position = 0;
    var previous_x = event_x[order[0]];
    while position < 2 * n {
        let x = event_x[order[position]];
        area += covered[1] * (x - previous_x);
        while position < 2 * n && event_x[order[position]] == x {
            let i = order[position];
            let l = lower_bound_prefix(ys, interval_count + 1, event_y1[i]);
            let r = lower_bound_prefix(ys, interval_count + 1, event_y2[i]);
            sweep_update(1, 0, interval_count, l, r, event_delta[i], count, covered, ys);
            position += 1;
        }
        previous_x = x;
    }
    println(area);
}
