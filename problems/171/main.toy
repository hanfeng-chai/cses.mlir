fn main() {
    let text = read_text();
    let size = length(text);
    let modulus = 1_000_000_007;
    let factorial = array(size + 1, 1);
    for value in 1..=size {
        factorial[value] = factorial[value - 1] * value % modulus;
    }
    let frequencies = array(26, 0);
    for index in 0..size {
        frequencies[at(text, index) - 97] += 1;
    }
    var answer = factorial[size];
    for letter in 0..26 {
        answer = answer * pow_mod(factorial[frequencies[letter]], modulus - 2, modulus)
            % modulus;
    }
    println(answer);
}