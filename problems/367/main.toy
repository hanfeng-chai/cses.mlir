fn main() {
    let n = read();
    let m = read();
    var heights = array(m, 0);
    let stack = array(m + 1, 0);
    var best = 0;
    for row in 0..n {
        let line = read_text();
        for col in 0..m {
            if at(line, col) == 42 {
                heights[col] = 0;
            } else {
                heights[col] += 1;
            }
        }
        var top = 0;
        for col in 0..=m {
            var current = 0;
            if col < m {
                current = heights[col];
            }
            while top > 0 && heights[stack[top - 1]] >= current {
                let height = heights[stack[top - 1]];
                top -= 1;
                var left = -1;
                if top > 0 {
                    left = stack[top - 1];
                }
                let width = col - left - 1;
                if height * width > best {
                    best = height * width;
                }
            }
            stack[top] = col;
            top += 1;
        }
    }
    println(best);
}
