fn main() {
    let n = read();
    let k = read();
    let x = read();
    let a = read();
    let b = read();
    let c = read();
    let arr = array(n, 0);
    var prev = x;
    arr[0] = x;
    for i in 1..n {
        prev = (a * prev + b) % c;
        arr[i] = prev;
    }
    var window_xor = 0;
    for i in 0..k {
        window_xor ^= arr[i];
    }
    var answer = window_xor;
    for i in k..n {
        window_xor ^= arr[i] ^ arr[i - k];
        answer ^= window_xor;
    }
    println(answer);
}
