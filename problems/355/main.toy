fn main() {
    let n = read();
    let m = read();
    var head = array(n + 1, 0);
    for i in 0..=n {
        head[i] = -1;
    }
    let edges = 2 * m;
    let to = array(edges, 0);
    let delta = array(edges, 0);
    let next_edge = array(edges, 0);
    var edge_count = 0;
    for i in 0..m {
        let l = read();
        let r = read();
        let s = read();
        let u = l - 1;
        let v = r;
        to[edge_count] = v;
        delta[edge_count] = s;
        next_edge[edge_count] = head[u];
        head[u] = edge_count;
        edge_count += 1;
        to[edge_count] = u;
        delta[edge_count] = 0 - s;
        next_edge[edge_count] = head[v];
        head[v] = edge_count;
        edge_count += 1;
    }

    var visited = array(n + 1, 0);
    var prefix = array(n + 1, 0);
    var cursor = array(n + 1, 0);
    for i in 0..=n {
        cursor[i] = -1;
    }
    var stack = array(n + 1, 0);
    var ok = true;

    var start = 0;
    while start <= n && ok {
        if visited[start] == 0 {
            visited[start] = 1;
            prefix[start] = 0;
            cursor[start] = head[start];
            var top = 0;
            stack[0] = start;
            while top >= 0 && ok {
                let u = stack[top];
                if cursor[u] == -1 {
                    top -= 1;
                } else {
                    let edge = cursor[u];
                    cursor[u] = next_edge[edge];
                    let v = to[edge];
                    let want = prefix[u] + delta[edge];
                    if visited[v] == 0 {
                        visited[v] = 1;
                        prefix[v] = want;
                        cursor[v] = head[v];
                        top += 1;
                        stack[top] = v;
                    } else if prefix[v] != want {
                        ok = false;
                    }
                }
            }
        }
        start += 1;
    }

    if !ok {
        print("NO\n");
        return;
    }
    print("YES\n");
    for i in 1..=n {
        print(prefix[i] - prefix[i - 1]);
        print(" ");
    }
    print("\n");
}
