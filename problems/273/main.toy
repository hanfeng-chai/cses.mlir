fn main() {
    let n = read();
    var a = array(n + 1, 0);
    for d in 0..10 {
        print("? ");
        for i in 1..=n {
            if ((i >> d) & 1) == 1 {
                put(49);
            } else {
                put(48);
            }
        }
        put(10);
        flush();
        let response = read_text();
        for i in 1..=n {
            if at(response, i - 1) == 49 {
                a[i] |= 1 << d;
            }
        }
    }
    print("! ");
    for i in 1..=n {
        if i > 1 {
            print(" ");
        }
        print(a[i]);
    }
    println();
    flush();
}
